        <mxCell id="factoryRealization" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;dashed=1;strokeColor=#8A6A00;strokeWidth=2;fontColor=#755B00;fontSize=12;fontStyle=1;labelBackgroundColor=#EDF3FC;" edge="1" parent="1" source="factory" target="factoryInterface"><mxGeometry relative="1" as="geometry"/></mxCell>
