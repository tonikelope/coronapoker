        <mxCell id="title" value="CoronaPoker 24.11 GDX class architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#F8D66D;" vertex="1" parent="1"><mxGeometry x="45" y="18" width="1100" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Verified creation path, session ownership and renderer-neutral table loop." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#D6E4F0;" vertex="1" parent="1"><mxGeometry x="47" y="64" width="1400" height="28" as="geometry"/></mxCell>

        <mxCell id="startupLane" value="APPLICATION ASSEMBLY" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#17243A;swimlaneFillColor=#0C1524;strokeColor=#26BDE2;fontColor=#7DE3FA;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="110" width="2110" height="390" as="geometry"/></mxCell>
        <mxCell id="launcher" value="&lt;b&gt;GdxLauncher&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;+ main(args)&lt;br&gt;+ launchWindow(...)&lt;br&gt;production entry point&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D3B50;strokeColor=#26BDE2;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;" vertex="1" parent="1"><mxGeometry x="85" y="250" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="bootstrap" value="&lt;b&gt;CoronaPokerBootstrap&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;+ createApplication()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24452F;strokeColor=#75C98A;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="430" y="165" width="285" height="78" as="geometry"/></mxCell>
        <mxCell id="application" value="&lt;b&gt;CoronaPokerApplication&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;shared service lifecycle&lt;br&gt;preferences, database, updates and audio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24452F;strokeColor=#75C98A;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="805" y="158" width="335" height="92" as="geometry"/></mxCell>
        <mxCell id="factory" value="&lt;b&gt;CoreGameTableFactory&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;implements GameTableFactory&lt;br&gt;builds the canonical table graph&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24452F;strokeColor=#75C98A;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="430" y="270" width="285" height="90" as="geometry"/></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;NetworkLobbyGateway&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;implements NewGameSessionGateway&lt;br&gt;owns host or client network lobby&lt;br&gt;uses GameTableFactory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24452F;strokeColor=#75C98A;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="805" y="263" width="335" height="105" as="geometry"/></mxCell>
        <mxCell id="shell" value="&lt;b&gt;GdxApplicationShell&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;owns the window, screens and active table&lt;br&gt;creates GdxTableRenderer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D3B50;strokeColor=#26BDE2;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="430" y="390" width="285" height="85" as="geometry"/></mxCell>
        <mxCell id="frontend" value="&lt;b&gt;GdxFrontendScreen&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;menu, setup, lobby, statistics and results&lt;br&gt;submits NewGameRequest values&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D3B50;strokeColor=#26BDE2;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="805" y="390" width="335" height="85" as="geometry"/></mxCell>
        <mxCell id="compositionNote" value="&lt;b&gt;Composition root&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;GdxLauncher constructs core services and injects them into the GDX application.&lt;br&gt;Core classes never construct or import GDX classes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#142338;strokeColor=#607D9B;fontColor=#D6E4F0;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1390" y="230" width="600" height="120" as="geometry"/></mxCell>
        <mxCell id="launcherBootstrap" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#75C98A;strokeWidth=2;fontColor=#9AE6A8;fontSize=13;fontStyle=1;labelBackgroundColor=#0C1524;exitX=1;exitY=0.20;entryX=0;entryY=0.5;" edge="1" parent="1" source="launcher" target="bootstrap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bootstrapApplication" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=diamond;endFill=1;strokeColor=#75C98A;strokeWidth=2;fontColor=#9AE6A8;fontSize=13;fontStyle=1;labelBackgroundColor=#0C1524;" edge="1" parent="1" source="bootstrap" target="application"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="launcherFactory" value="constructs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#75C98A;strokeWidth=2;fontColor=#9AE6A8;fontSize=13;fontStyle=1;labelBackgroundColor=#0C1524;exitX=1;exitY=0.50;entryX=0;entryY=0.5;" edge="1" parent="1" source="launcher" target="factory"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="factoryGateway" value="injected into" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#75C98A;strokeWidth=2;fontColor=#9AE6A8;fontSize=13;fontStyle=1;labelBackgroundColor=#0C1524;" edge="1" parent="1" source="factory" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="launcherShell" value="constructs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#26BDE2;strokeWidth=2;fontColor=#7DE3FA;fontSize=13;fontStyle=1;labelBackgroundColor=#0C1524;exitX=1;exitY=0.82;entryX=0;entryY=0.5;" edge="1" parent="1" source="launcher" target="shell"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="shellFrontend" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=diamond;endFill=1;strokeColor=#26BDE2;strokeWidth=2;fontColor=#7DE3FA;fontSize=13;fontStyle=1;labelBackgroundColor=#0C1524;" edge="1" parent="1" source="shell" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="frontendGateway" value="opens session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#75C98A;strokeWidth=2;fontColor=#9AE6A8;fontSize=13;fontStyle=1;labelBackgroundColor=#0C1524;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="frontend" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="sessionLane" value="SESSION OWNERSHIP" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;align=left;spacingLeft=20;fillColor=#173028;swimlaneFillColor=#091B17;strokeColor=#75C98A;fontColor=#9AE6A8;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="530" width="2110" height="235" as="geometry"/></mxCell>
        <mxCell id="lobby" value="&lt;b&gt;LobbySession&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;owns lobby lifetime and commands&lt;br&gt;publishes one TableSession&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24452F;strokeColor=#75C98A;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="620" y="615" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="tableSession" value="&lt;b&gt;TableSession&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;owns initial TableSnapshot, commands and events&lt;br&gt;+ attach(TableRenderer)&lt;br&gt;starts the engine after renderer.open completes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263952;strokeColor=#8AB4F8;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1060" y="597" width="380" height="125" as="geometry"/></mxCell>
        <mxCell id="gatewayLobby" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=diamond;endFill=1;strokeColor=#75C98A;strokeWidth=2;exitX=1;exitY=0.65;entryX=0.5;entryY=0;" edge="1" parent="1" source="gateway" target="lobby"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="331"/><mxPoint x="1190" y="580"/><mxPoint x="770" y="580"/></Array></mxGeometry></mxCell>
        <mxCell id="lobbyTable" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#75C98A;strokeWidth=2;fontColor=#9AE6A8;fontSize=13;fontStyle=1;labelBackgroundColor=#091B17;" edge="1" parent="1" source="lobby" target="tableSession"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="sessionNote" value="The lobby remains the owner while the table is active. Closing TableSession stops owned controller and network work before the renderer closes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#142A23;strokeColor=#4B8060;fontColor=#CDEAD5;fontSize=13;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1570" y="607" width="500" height="105" as="geometry"/></mxCell>

        <mxCell id="loopLane" value="RENDERER-NEUTRAL TABLE LOOP" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;align=left;spacingLeft=20;fillColor=#17243A;swimlaneFillColor=#091321;strokeColor=#8AB4F8;fontColor=#B8D2FF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="795" width="2110" height="440" as="geometry"/></mxCell>
        <mxCell id="commandSink" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;TableCommandSink&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;+ submit(TableCommand)&lt;br&gt;frontend decision input&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263952;strokeColor=#8AB4F8;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="85" y="925" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="crupier" value="&lt;b&gt;Crupier&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;canonical hand progression&lt;br&gt;rules and network coordination&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3B2D45;strokeColor=#C58BE2;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="430" y="935" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="eventBridge" value="&lt;b&gt;TableEventBridge&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;+ publish(TableVisualEvent)&lt;br&gt;serializes visual output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263952;strokeColor=#8AB4F8;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="775" y="935" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="renderer" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;TableRenderer&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;+ open(TableSnapshot)&lt;br&gt;+ render(TableVisualEvent)&lt;br&gt;+ close()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263952;strokeColor=#8AB4F8;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1120" y="920" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="gdxRenderer" value="&lt;b&gt;GdxTableRenderer&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;implements TableRenderer&lt;br&gt;moves events onto the render thread&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D3B50;strokeColor=#26BDE2;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1490" y="935" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="gdxTable" value="&lt;b&gt;CoronaPokerGdxTable&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;draws the scene&lt;br&gt;captures player input&lt;br&gt;completes animation barriers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D3B50;strokeColor=#26BDE2;strokeWidth=2;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1880" y="925" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="inputFlow" value="commands" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8AB4F8;strokeWidth=2.5;fontColor=#B8D2FF;fontSize=13;fontStyle=1;labelBackgroundColor=#091321;" edge="1" parent="1" source="commandSink" target="crupier"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eventFlow" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8AB4F8;strokeWidth=2.5;fontColor=#B8D2FF;fontSize=13;fontStyle=1;labelBackgroundColor=#091321;" edge="1" parent="1" source="crupier" target="eventBridge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="renderFlow" value="ordered delivery" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8AB4F8;strokeWidth=2.5;fontColor=#B8D2FF;fontSize=13;fontStyle=1;labelBackgroundColor=#091321;" edge="1" parent="1" source="eventBridge" target="renderer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="implementsRenderer" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;dashed=1;strokeColor=#26BDE2;strokeWidth=2.5;fontColor=#7DE3FA;fontSize=13;fontStyle=1;labelBackgroundColor=#091321;" edge="1" parent="1" source="gdxRenderer" target="renderer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="updatesTable" value="opens and updates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#26BDE2;strokeWidth=2.5;fontColor=#7DE3FA;fontSize=13;fontStyle=1;labelBackgroundColor=#091321;" edge="1" parent="1" source="gdxRenderer" target="gdxTable"><mxGeometry relative="1" as="geometry"/></mxCell>
