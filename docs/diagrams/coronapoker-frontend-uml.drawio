        <mxCell id="launcherShell" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#25A9D6;strokeWidth=2;fontColor=#147A99;fontSize=13;fontStyle=1;labelBackgroundColor=#EDF3FC;exitX=1;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="launcher" target="shell"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="445"/><mxPoint x="1580" y="445"/><mxPoint x="1580" y="195"/></Array></mxGeometry></mxCell>
        <mxCell id="shellFrontend" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamond;startFill=1;endArrow=open;endFill=0;strokeColor=#25A9D6;strokeWidth=2;fontColor=#147A99;fontSize=13;fontStyle=1;labelBackgroundColor=#EDF3FC;" edge="1" parent="1" source="shell" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell>
