        <mxCell id="inputNote" value="CoronaPokerGdxTable submits player decisions through the TableCommandSink held by GdxTableRenderer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2635;strokeColor=#607D9B;fontColor=#C9D7E5;fontSize=13;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="125" y="1100" width="760" height="60" as="geometry"/></mxCell>
        <mxCell id="barrierNote" value="TableSnapshot opens the scene. Each ordered TableVisualEvent returns a CompletionStage used only as a visual completion barrier." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2635;strokeColor=#607D9B;fontColor=#C9D7E5;fontSize=13;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1030" y="1100" width="980" height="60" as="geometry"/></mxCell>
