        <mxCell id="subtitle" value="Construction, session ownership, commands and ordered presentation." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#52627A;" vertex="1" parent="1"><mxGeometry x="47" y="64" width="1500" height="28" as="geometry"/></mxCell>

