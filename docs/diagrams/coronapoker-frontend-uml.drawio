  <diagram id="frontend-uml" name="GDX runtime class and data flow">
    <mxGraphModel dx="2400" dy="1385" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1385" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="CoronaPoker GDX runtime class and data flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#17233B;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="18" width="1450" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Composition, session handoff, commands and ordered presentation without crossed ownership." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#17233B;fontSize=16;fontColor=#52627A;" vertex="1" parent="1"><mxGeometry x="47" y="64" width="1700" height="28" as="geometry"/></mxCell>
        <mxCell id="assemblyLane" value="APPLICATION ASSEMBLY" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#294A79;swimlaneFillColor=#FFFFFF;strokeColor=#294A79;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="2360" height="340" as="geometry"/></mxCell>
        <mxCell id="launcher" value="&lt;b&gt;GdxLauncher&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;main(args)&lt;br&gt;composition root and production entry point&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="260" height="105" as="geometry"/></mxCell>
        <mxCell id="bootstrap" value="&lt;b&gt;CoronaPokerBootstrap&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;creates process services&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="180" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="application" value="&lt;b&gt;CoronaPokerApplication&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;owns service lifecycle, preferences,&lt;br&gt;database, updates and audio&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="750" y="180" width="320" height="90" as="geometry"/></mxCell>
        <mxCell id="factory" value="&lt;b&gt;CoreGameTableFactory&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;implements GameTableFactory&lt;br&gt;builds the canonical table graph&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;NetworkLobbyGateway&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;implements NewGameSessionGateway&lt;br&gt;opens host or client transport&lt;br&gt;uses GameTableFactory&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="750" y="310" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="shell" value="&lt;b&gt;GdxApplicationShell&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;coordinates screens and active table scene&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1270" y="180" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="frontend" value="&lt;b&gt;GdxFrontendScreen&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;menu, setup, lobby and statistics&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1710" y="180" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="assemblyNote" value="&lt;b&gt;Composition root&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;GdxLauncher creates the application services, table factory, network gateway and GDX shell.&lt;br&gt;The core does not import libGDX.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#90A4BC;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1270" y="310" width="740" height="90" as="geometry"/></mxCell>
        <mxCell id="launcherBootstrap" value="calls" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.28;entryX=0;entryY=0.50;" edge="1" parent="1" source="launcher" target="bootstrap"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="bootstrapApplication" value="creates" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.50;entryX=0;entryY=0.50;" edge="1" parent="1" source="bootstrap" target="application"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="launcherFactory" value="creates" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.72;entryX=0;entryY=0.50;" edge="1" parent="1" source="launcher" target="factory"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="factoryGateway" value="injects" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.50;entryX=0;entryY=0.50;" edge="1" parent="1" source="factory" target="gateway"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="shellFrontend" value="owns" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#25A9D6;strokeWidth=2.4;fontColor=#147A99;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.50;entryX=0;entryY=0.50;" edge="1" parent="1" source="shell" target="frontend"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="sessionLane" value="SESSION OWNERSHIP AND TABLE ATTACHMENT" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#347C53;swimlaneFillColor=#FFFFFF;strokeColor=#347C53;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="2360" height="300" as="geometry"/></mxCell>
        <mxCell id="frontendSession" value="&lt;b&gt;GdxFrontendScreen&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;submits NewGameRequest&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="565" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="gatewaySession" value="&lt;b&gt;NetworkLobbyGateway&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;validates setup and owns transport&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="380" y="565" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="lobby" value="&lt;b&gt;LobbySession&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;owns lobby state, commands and transport&lt;br&gt;publishes one TableSession&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="740" y="565" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="tableSession" value="&lt;b&gt;TableSession&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;owns initial snapshot, commands and event bridge&lt;br&gt;starts the engine only after renderer.open completes&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E7;strokeColor=#D79B00;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1120" y="565" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="shellSession" value="&lt;b&gt;GdxApplicationShell&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;awaits the handoff and calls attach(renderer)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1540" y="565" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="rendererAttach" value="&lt;b&gt;GdxTableRenderer&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;created for the session&lt;br&gt;posts work to the render thread&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1920" y="565" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="openSession" value="request" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.50;entryX=0;entryY=0.50;" edge="1" parent="1" source="frontendSession" target="gatewaySession"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="createLobby" value="creates" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.50;entryX=0;entryY=0.50;" edge="1" parent="1" source="gatewaySession" target="lobby"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="publishSession" value="publishes" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.50;entryX=0;entryY=0.50;" edge="1" parent="1" source="lobby" target="tableSession"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="awaitSession" value="awaits" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#607D9B;strokeWidth=2.4;fontColor=#52627A;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.50;entryX=1;entryY=0.50;" edge="1" parent="1" source="shellSession" target="tableSession"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="createRenderer" value="creates" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#25A9D6;strokeWidth=2.4;fontColor=#147A99;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.50;entryX=0;entryY=0.50;" edge="1" parent="1" source="shellSession" target="rendererAttach"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="sessionNote" value="TableSession.attach opens exactly one renderer. The engine starts only after that presentation barrier completes." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F4FAF6;strokeColor=#7AA98B;strokeWidth=2;fontColor=#285F40;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="650" y="700" width="1100" height="44" as="geometry"/></mxCell>
        <mxCell id="loopLane" value="RENDERER-NEUTRAL TABLE LOOP" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#70499B;swimlaneFillColor=#FFFFFF;strokeColor=#70499B;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="2360" height="567" as="geometry"/></mxCell>
        <mxCell id="gdxTable" value="&lt;b&gt;CoronaPokerGdxTable&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;draws the table and final summary&lt;br&gt;captures player input&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="905" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="commandSink" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;TableCommandSink&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;submit(TableCommand)&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E7;strokeColor=#D79B00;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="905" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="commandAdapter" value="&lt;b&gt;Core command adapter&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;validates and dispatches each request&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="905" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="crupier" value="&lt;b&gt;Crupier and controllers&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;authoritative hand progression,&lt;br&gt;rules and network coordination&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F7F0FC;strokeColor=#9A63BF;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="895" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="loopNote" value="&lt;b&gt;Authority and barriers&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Commands are requests. The core validates them and decides the game result.&lt;br&gt;&lt;br&gt;TableVisualEvent values describe presentation. CompletionStage values are real visual barriers only where hand progression must wait.&lt;br&gt;&lt;br&gt;GDX never becomes authoritative for poker rules.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#90A4BC;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1710" y="895" width="600" height="350" as="geometry"/></mxCell>
        <mxCell id="gdxRenderer" value="&lt;b&gt;GdxTableRenderer&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;implements TableRenderer&lt;br&gt;updates the GDX scene on the render thread&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="50" y="1135" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="renderer" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;TableRenderer&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;open(snapshot)&lt;br&gt;render(event)&lt;br&gt;close()&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E7;strokeColor=#D79B00;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="440" y="1135" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="presentation" value="&lt;b&gt;TablePresentation&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;assigns monotonic sequence values&lt;br&gt;queues while opening and preserves order&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E7;strokeColor=#D79B00;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="1135" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="eventBridge" value="&lt;b&gt;TableEventBridge&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;attaches one presentation&lt;br&gt;publishes TableVisualEvent values&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E7;strokeColor=#D79B00;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="1135" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="input1" value="submits" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.50;entryX=0;entryY=0.50;" edge="1" parent="1" source="gdxTable" target="commandSink"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="input2" value="dispatches" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.50;entryX=0;entryY=0.50;" edge="1" parent="1" source="commandSink" target="commandAdapter"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="input3" value="invokes" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.50;entryX=0;entryY=0.50;" edge="1" parent="1" source="commandAdapter" target="crupier"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="output1" value="publishes" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#70499B;strokeWidth=2.4;fontColor=#4E3670;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.50;exitY=1;entryX=0.50;entryY=0;" edge="1" parent="1" source="crupier" target="eventBridge"><mxGeometry relative="1" as="geometry"><mxPoint x="-48" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="output2" value="orders" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#70499B;strokeWidth=2.4;fontColor=#4E3670;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.50;entryX=1;entryY=0.50;" edge="1" parent="1" source="eventBridge" target="presentation"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="output3" value="renders" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#70499B;strokeWidth=2.4;fontColor=#4E3670;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.50;entryX=1;entryY=0.50;" edge="1" parent="1" source="presentation" target="renderer"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="output4" value="implements" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#25A9D6;strokeWidth=2.4;fontColor=#147A99;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.50;entryX=1;entryY=0.50;" edge="1" parent="1" source="renderer" target="gdxRenderer"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="updateScene" value="updates scene" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#25A9D6;strokeWidth=2.4;fontColor=#147A99;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.50;exitY=0;entryX=0.50;entryY=1;" edge="1" parent="1" source="gdxRenderer" target="gdxTable"><mxGeometry relative="1" as="geometry"><mxPoint x="-50" y="0" as="offset"/></mxGeometry></mxCell>
        <mxCell id="loopFooter" value="The initial TableSnapshot opens the scene. Later state arrives as ordered events. The core remains authoritative throughout." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#90A4BC;strokeWidth=2;fontColor=#52627A;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="500" y="1295" width="1080" height="42" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
