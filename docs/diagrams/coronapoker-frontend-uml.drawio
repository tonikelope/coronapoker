        <mxCell id="gatewayLobby" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#347C53;strokeWidth=2;fontColor=#285F40;fontSize=13;fontStyle=1;labelBackgroundColor=#EEF8F2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gateway" target="lobby"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1348" y="475"/><mxPoint x="90" y="475"/><mxPoint x="90" y="580"/><mxPoint x="340" y="580"/></Array></mxGeometry></mxCell>
        <mxCell id="lobbyTable" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamond;startFill=1;endArrow=open;endFill=0;strokeColor=#347C53;strokeWidth=2;fontColor=#285F40;fontSize=13;fontStyle=1;labelBackgroundColor=#EEF8F2;" edge="1" parent="1" source="lobby" target="tableSession"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="shellAwaits" value="awaits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#607D9B;strokeWidth=2;fontColor=#52627A;fontSize=13;fontStyle=1;labelBackgroundColor=#EEF8F2;" edge="1" parent="1" source="shellSession" target="tableSession"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="shellCreatesRenderer" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#25A9D6;strokeWidth=2;fontColor=#147A99;fontSize=13;fontStyle=1;labelBackgroundColor=#EEF8F2;" edge="1" parent="1" source="shellSession" target="gdxRendererAttach"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="attachRenderer" value="attach(renderer)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#8A6A00;strokeWidth=2;fontColor=#755B00;fontSize=13;fontStyle=1;labelBackgroundColor=#EEF8F2;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="tableSession" target="gdxRendererAttach"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="775"/><mxPoint x="2070" y="775"/></Array></mxGeometry></mxCell>

        <mxCell id="loopLane" value="RENDERER-NEUTRAL TABLE LOOP" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;align=left;spacingLeft=20;fillColor=#6D4B99;swimlaneFillColor=#F5F0FB;strokeColor=#6D4B99;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="840" width="2310" height="510" as="geometry"/></mxCell>
        <mxCell id="gdxTable" value="&lt;b&gt;CoronaPokerGdxTable&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;draws the table and final summary&lt;br&gt;captures player input&lt;br&gt;completes animation barriers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="105" y="945" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="commandSink" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;TableCommandSink&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;+ submit(TableCommand)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#D4A51D;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="955" width="265" height="105" as="geometry"/></mxCell>
        <mxCell id="commandAdapter" value="&lt;b&gt;CoreGameTableFactory command adapter&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;validates and dispatches each command&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="955" width="330" height="105" as="geometry"/></mxCell>
        <mxCell id="crupier" value="&lt;b&gt;Crupier and game controllers&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;canonical hand progression&lt;br&gt;rules and network coordination&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7EEFA;strokeColor=#9C62B8;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1300" y="950" width="320" height="115" as="geometry"/></mxCell>
        <mxCell id="eventBridge" value="&lt;b&gt;TableEventBridge&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;attaches one presentation&lt;br&gt;publishes TableVisualEvent values&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#D4A51D;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1845" y="950" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="presentation" value="&lt;b&gt;TablePresentation&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;assigns monotonic event sequence&lt;br&gt;queues events during renderer opening&lt;br&gt;preserves ordered delivery&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#D4A51D;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1700" y="1175" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="renderer" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;TableRenderer&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;+ open(TableSnapshot)&lt;br&gt;+ render(TableVisualEvent)&lt;br&gt;+ close()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#D4A51D;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1190" y="1175" width="315" height="130" as="geometry"/></mxCell>
        <mxCell id="rendererInstance" value="&lt;b&gt;GdxTableRenderer&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;posts render calls to the GDX thread&lt;br&gt;holds the TableCommandSink&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="685" y="1180" width="350" height="120" as="geometry"/></mxCell>
        <mxCell id="input1" value="submits" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#347C53;strokeWidth=2.5;fontColor=#285F40;fontSize=13;fontStyle=1;labelBackgroundColor=#F5F0FB;" edge="1" parent="1" source="gdxTable" target="commandSink"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="input2" value="dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#347C53;strokeWidth=2.5;fontColor=#285F40;fontSize=13;fontStyle=1;labelBackgroundColor=#F5F0FB;" edge="1" parent="1" source="commandSink" target="commandAdapter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="input3" value="invokes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#347C53;strokeWidth=2.5;fontColor=#285F40;fontSize=13;fontStyle=1;labelBackgroundColor=#F5F0FB;" edge="1" parent="1" source="commandAdapter" target="crupier"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="output1" value="TableVisualEvent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6D4B99;strokeWidth=2.5;fontColor=#4E3670;fontSize=13;fontStyle=1;labelBackgroundColor=#F5F0FB;" edge="1" parent="1" source="crupier" target="eventBridge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bridgeOwnsPresentation" value="attaches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamond;startFill=1;endArrow=open;endFill=0;strokeColor=#8A6A00;strokeWidth=2;fontColor=#755B00;fontSize=12;fontStyle=1;labelBackgroundColor=#F5F0FB;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="eventBridge" target="presentation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="output2" value="ordered render calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6D4B99;strokeWidth=2.5;fontColor=#4E3670;fontSize=13;fontStyle=1;labelBackgroundColor=#F5F0FB;" edge="1" parent="1" source="presentation" target="renderer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rendererRealization" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;dashed=1;strokeColor=#25A9D6;strokeWidth=2.5;fontColor=#147A99;fontSize=13;fontStyle=1;labelBackgroundColor=#F5F0FB;" edge="1" parent="1" source="rendererInstance" target="renderer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="updatesTable" value="opens and updates scene" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#25A9D6;strokeWidth=2.5;fontColor=#147A99;fontSize=13;fontStyle=1;labelBackgroundColor=#F5F0FB;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="rendererInstance" target="gdxTable"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="1240"/><mxPoint x="455" y="1125"/><mxPoint x="255" y="1125"/></Array></mxGeometry></mxCell>
