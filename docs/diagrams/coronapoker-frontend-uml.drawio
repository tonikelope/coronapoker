        <mxCell id="launcher" value="&lt;b&gt;GdxLauncher&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;+ main(args)&lt;br&gt;+ launchWindow(...)&lt;br&gt;production entry point&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="85" y="230" width="235" height="110" as="geometry"/></mxCell>
        <mxCell id="bootstrap" value="&lt;b&gt;CoronaPokerBootstrap&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;+ createApplication()&lt;br&gt;constructs shared services&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="405" y="150" width="275" height="90" as="geometry"/></mxCell>
        <mxCell id="application" value="&lt;b&gt;CoronaPokerApplication&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;owns shared service lifecycle&lt;br&gt;preferences, database, updates and audio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="775" y="150" width="325" height="90" as="geometry"/></mxCell>
        <mxCell id="factoryInterface" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;GameTableFactory&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;+ create(GameLaunchContext)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#D4A51D;strokeWidth=2;fontColor=#17233B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="405" y="285" width="275" height="85" as="geometry"/></mxCell>
        <mxCell id="factory" value="&lt;b&gt;CoreGameTableFactory&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;builds the canonical table graph&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="775" y="285" width="325" height="85" as="geometry"/></mxCell>
        <mxCell id="gatewayInterface" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;NewGameSessionGateway&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;+ open(NewGameRequest)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#D4A51D;strokeWidth=2;fontColor=#17233B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1190" y="150" width="315" height="90" as="geometry"/></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;NetworkLobbyGateway&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;opens host or client transport&lt;br&gt;uses GameTableFactory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F2;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1190" y="285" width="315" height="90" as="geometry"/></mxCell>
        <mxCell id="shell" value="&lt;b&gt;GdxApplicationShell&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;coordinates screens and active table scene&lt;br&gt;creates GdxTableRenderer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1630" y="150" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="frontend" value="&lt;b&gt;GdxFrontendScreen&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;menu, setup, lobby and statistics&lt;br&gt;submits NewGameRequest values&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="2020" y="150" width="295" height="90" as="geometry"/></mxCell>
        <mxCell id="compositionNote" value="&lt;b&gt;Composition root&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;CoronaPokerBootstrap creates the shared application services. GdxLauncher creates the GDX adapters, table factory, network gateway and application shell. Core code imports no libGDX classes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#607D9B;fontColor=#35445A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1630" y="295" width="685" height="90" as="geometry"/></mxCell>

        <mxCell id="launcherBootstrap" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#347C53;strokeWidth=2;fontColor=#285F40;fontSize=13;fontStyle=1;labelBackgroundColor=#EDF3FC;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="launcher" target="bootstrap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="bootstrapApplication" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#347C53;strokeWidth=2;fontColor=#285F40;fontSize=13;fontStyle=1;labelBackgroundColor=#EDF3FC;" edge="1" parent="1" source="bootstrap" target="application"><mxGeometry relative="1" as="geometry"/></mxCell>
