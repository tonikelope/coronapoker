        <mxCell id="sessionLane" value="SESSION OWNERSHIP AND TABLE ATTACHMENT" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;align=left;spacingLeft=20;fillColor=#347C53;swimlaneFillColor=#EEF8F2;strokeColor=#347C53;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="520" width="2310" height="290" as="geometry"/></mxCell>
        <mxCell id="lobby" value="&lt;b&gt;LobbySession&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;owns lobby state, commands and transport&lt;br&gt;publishes one TableSession&lt;br&gt;closes the published table with the lobby&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="170" y="615" width="340" height="120" as="geometry"/></mxCell>
        <mxCell id="tableSession" value="&lt;b&gt;TableSession&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;owns initial TableSnapshot, commands and event bridge&lt;br&gt;+ attach(TableRenderer)&lt;br&gt;starts the engine after renderer.open completes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7DC;strokeColor=#D4A51D;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="685" y="605" width="410" height="140" as="geometry"/></mxCell>
        <mxCell id="shellSession" value="&lt;b&gt;GdxApplicationShell&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;awaits the table session&lt;br&gt;creates the renderer and calls attach(renderer)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1300" y="615" width="365" height="120" as="geometry"/></mxCell>
