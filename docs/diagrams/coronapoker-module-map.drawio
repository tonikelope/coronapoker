      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="CoronaPoker — Swing + GDX architecture" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#17233c;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="22" width="1200" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Three physical Java source owners, one game engine and shared networking, persistence and resource contracts." style="text;html=1;fontSize=15;fontColor=#56627a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="66" width="1500" height="26" as="geometry"/></mxCell>
        <mxCell id="appsBand" value="DISTRIBUTED APPLICATIONS" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#263d66;swimlaneFillColor=#eef3fb;strokeColor=#263d66;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1700" height="225" as="geometry"/></mxCell>
        <mxCell id="swingJar" value="&lt;b&gt;CoronaPoker-24.11-swing.jar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#44516a&quot;&gt;modules/coronapoker-swing/src/main/java&lt;br&gt;SwingLauncher · menus, lobby, table and classic dialogs&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b82be;strokeWidth=2;fontColor=#17233c;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="150" y="185" width="600" height="105" as="geometry"/></mxCell>
        <mxCell id="gdxJar" value="&lt;b&gt;CoronaPoker-24.11-gdx.jar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#44516a&quot;&gt;modules/coronapoker-gdx/src/main/java&lt;br&gt;GdxLauncher · GdxApplicationShell · GdxFrontendScreen&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#20a7c9;strokeWidth=2;fontColor=#17233c;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="185" width="600" height="105" as="geometry"/></mxCell>
        <mxCell id="contractsBand" value="PRESENTATION BOUNDARY" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#6a4c93;swimlaneFillColor=#f4effa;strokeColor=#6a4c93;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="385" width="1700" height="170" as="geometry"/></mxCell>
        <mxCell id="swingAdapter" value="&lt;b&gt;Swing adapters&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#514660&quot;&gt;GameFrame · WaitingRoomFrame · Player views&lt;br&gt;implement and consume core contracts&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8064a2;strokeWidth=2;fontColor=#241a33;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="160" y="440" width="520" height="82" as="geometry"/></mxCell>
        <mxCell id="ports" value="&lt;b&gt;Renderer-neutral ports, sessions and events&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#514660&quot;&gt;LobbySession · TableSession · TableRenderer&lt;br&gt;decisions, dialogs, log, audio, chat, state and animation barriers&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf4;strokeColor=#d4aa36;strokeWidth=2;fontColor=#3d3219;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="705" y="430" width="390" height="102" as="geometry"/></mxCell>
        <mxCell id="gdxAdapter" value="&lt;b&gt;GDX adapters&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#514660&quot;&gt;GdxTableRenderer · views and overlays&lt;br&gt;translate core events into GPU presentation&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#20a7c9;strokeWidth=2;fontColor=#17333c;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="440" width="520" height="82" as="geometry"/></mxCell>
        <mxCell id="coreBand" value="SHARED CORE — modules/coronapoker-core/src/main/java" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#b94a48;swimlaneFillColor=#fcedec;strokeColor=#b94a48;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="600" width="1700" height="285" as="geometry"/></mxCell>
        <mxCell id="session" value="&lt;b&gt;Game lifecycle&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;CoreGameTableFactory&lt;br&gt;lobby · connect · reconnect&lt;br&gt;pause · exit · recovery&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="105" y="670" width="280" height="145" as="geometry"/></mxCell>
        <mxCell id="dealer" value="&lt;b&gt;Engine and protocol&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;Crupier · turns · bets&lt;br&gt;deal · showdown · payout&lt;br&gt;RIT · rabbit · straddle · ante&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="670" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="rules" value="&lt;b&gt;Rules and exact money&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;BetRules · PotMath · MoneyCents&lt;br&gt;buy-ins · side pots · settlement&lt;br&gt;bots · hand evaluation&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="755" y="670" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="network" value="&lt;b&gt;Network and security&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;NetworkLobbyGateway · wire commands&lt;br&gt;SRA/Ristretto255 · DLEQ&lt;br&gt;verifiable shuffle · Ed25519 identity&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="670" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;b&gt;Persistence and data&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;SQLite · history · statistics&lt;br&gt;hand transactions · recovery&lt;br&gt;DebugLog · statistics synchronization&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1425" y="670" width="270" height="145" as="geometry"/></mxCell>
        <mxCell id="supportBand" value="RESOURCES, PACKAGING AND CERTIFICATION" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#3b7d55;swimlaneFillColor=#eaf5ed;strokeColor=#3b7d55;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="930" width="1700" height="175" as="geometry"/></mxCell>
        <mxCell id="assets" value="&lt;b&gt;coronapoker-assets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#415c49&quot;&gt;cards · sounds · images · fonts · MODs&lt;br&gt;resources shared by both frontends&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9e5e;strokeWidth=2;fontColor=#1f3b28;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="150" y="990" width="450" height="78" as="geometry"/></mxCell>
        <mxCell id="build" value="&lt;b&gt;Maven 24.11 reactor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#415c49&quot;&gt;root pom.xml → modules/pom.xml&lt;br&gt;core + assets → Swing / GDX → two executable JARs&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9e5e;strokeWidth=2;fontColor=#1f3b28;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="675" y="990" width="450" height="78" as="geometry"/></mxCell>
        <mxCell id="qa" value="&lt;b&gt;coronapoker-qa + tools/qa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#415c49&quot;&gt;architecture · core/Swing · native GDX · mixed Swing↔GDX&lt;br&gt;multi-process network, recovery and distribution contracts&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9e5e;strokeWidth=2;fontColor=#1f3b28;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="990" width="450" height="78" as="geometry"/></mxCell>
        <mxCell id="invariants" value="&lt;b&gt;Architecture invariants&lt;/b&gt;  ·  one poker engine in the core  ·  no hidden GameFrame controls GDX  ·  the render thread never waits for the engine  ·  Swing and GDX speak the same protocol  ·  every compiled class belongs to one module" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#17233c;strokeColor=#17233c;fontColor=#ffffff;fontSize=13;align=center;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="90" y="1130" width="1620" height="48" as="geometry"/></mxCell>
