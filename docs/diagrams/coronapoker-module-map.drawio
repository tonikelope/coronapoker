        <mxCell id="eContractsCore" value="typed boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#b94a48;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontColor=#8f3635;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ports" target="engine"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1295" y="610"/><mxPoint x="900" y="610"/></Array></mxGeometry></mxCell>
