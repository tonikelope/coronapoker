<mxfile host="app.diagrams.net" type="device">
  <diagram id="coronapoker-modules" name="Module map">
    <mxGraphModel dx="1800" dy="1240" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="CoronaPoker 24.11 architecture: Swing and GDX" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#17233c;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1350" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Two independent desktop applications, one renderer-neutral game engine, one resource set and one certification model." style="text;html=1;fontSize=15;fontColor=#56627a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="65" width="1600" height="26" as="geometry"/></mxCell>

        <mxCell id="appsBand" value="DISTRIBUTED APPLICATIONS" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#263d66;swimlaneFillColor=#eef3fb;strokeColor=#263d66;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="1700" height="205" as="geometry"/></mxCell>
        <mxCell id="swingJar" value="&lt;b&gt;CoronaPoker-24.11-swing.jar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#44516a&quot;&gt;Main: com.tonikelope.coronapoker.swing.SwingLauncher&lt;br&gt;Classic Swing menus, lobby, table and dialogs&lt;br&gt;Source owner: modules/coronapoker-swing/src/main/java&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b82be;strokeWidth=2;fontColor=#17233c;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="125" y="165" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="gdxJar" value="&lt;b&gt;CoronaPoker-24.11-gdx.jar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#44516a&quot;&gt;Main: com.tonikelope.coronapoker.gdx.GdxLauncher&lt;br&gt;libGDX menus, lobby, GPU table and overlays&lt;br&gt;Source owner: modules/coronapoker-gdx/src/main/java&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#20a7c9;strokeWidth=2;fontColor=#17233c;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1115" y="165" width="560" height="110" as="geometry"/></mxCell>
        <mxCell id="productRule" value="Each JAR contains the same core and assets, but exactly one frontend and one launcher." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dfe8f6;strokeColor=#9aacc8;fontColor=#34435d;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="190" width="400" height="58" as="geometry"/></mxCell>

        <mxCell id="presentationBand" value="FRONTEND BOUNDARY" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#6a4c93;swimlaneFillColor=#f4effa;strokeColor=#6a4c93;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="1700" height="225" as="geometry"/></mxCell>
        <mxCell id="swingAdapter" value="&lt;b&gt;Swing presentation adapters&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#514660&quot;&gt;GameFrame, WaitingRoomFrame and player views&lt;br&gt;Swing input, rendering, native dialogs and desktop integration&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8064a2;strokeWidth=2;fontColor=#241a33;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="125" y="420" width="560" height="105" as="geometry"/></mxCell>
        <mxCell id="ports" value="&lt;b&gt;Presentation contracts owned by the core&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#514660&quot;&gt;LobbySession, TableSession and TableRenderer&lt;br&gt;decisions, dialogs, log, audio and chat&lt;br&gt;state snapshots, lifecycle and animation barriers&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf4;strokeColor=#d4aa36;strokeWidth=2;fontColor=#3d3219;fontSize=14;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="735" y="405" width="330" height="135" as="geometry"/></mxCell>
        <mxCell id="gdxAdapter" value="&lt;b&gt;GDX presentation adapters&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#514660&quot;&gt;GdxApplicationShell, GdxTableRenderer and GDX views&lt;br&gt;libGDX input, GPU rendering, overlays and platform services&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#20a7c9;strokeWidth=2;fontColor=#17333c;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1115" y="420" width="560" height="105" as="geometry"/></mxCell>

        <mxCell id="coreBand" value="SHARED CORE: modules/coronapoker-core/src/main/java" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#b94a48;swimlaneFillColor=#fcedec;strokeColor=#b94a48;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="635" width="1700" height="375" as="geometry"/></mxCell>
        <mxCell id="engine" value="&lt;b&gt;Authoritative game engine and protocol orchestration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;CoreGameTableFactory and Crupier&lt;br&gt;turns, betting, dealing, showdown and payout&lt;br&gt;Publishes state and events. Accepts renderer-neutral decisions. Imports neither Swing nor libGDX.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffaf9;strokeColor=#c0504d;strokeWidth=2.2;fontColor=#3d2020;fontSize=15;align=center;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="500" y="700" width="800" height="115" as="geometry"/></mxCell>
        <mxCell id="lifecycle" value="&lt;b&gt;Lifecycle and table state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;lobby, connect and reconnect&lt;br&gt;pause, stop, exit and recovery&lt;br&gt;seat and session ownership&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="85" y="855" width="375" height="115" as="geometry"/></mxCell>
        <mxCell id="rules" value="&lt;b&gt;Rules, bots and exact money&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;BetRules, PotMath and MoneyCents&lt;br&gt;RIT, rabbit, straddle and ante&lt;br&gt;side pots, hand evaluation and bots&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="485" y="855" width="375" height="115" as="geometry"/></mxCell>
        <mxCell id="network" value="&lt;b&gt;Networking and security&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;NetworkLobbyGateway and wire commands&lt;br&gt;SRA/Ristretto255, DLEQ and signed actions&lt;br&gt;verifiable shuffle and Ed25519 identity&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="855" width="375" height="115" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;b&gt;Persistence and diagnostics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;SQLite history and statistics&lt;br&gt;hand transactions, settlement and recovery&lt;br&gt;DebugLog and statistics synchronization&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="855" width="375" height="115" as="geometry"/></mxCell>

        <mxCell id="supportBand" value="RESOURCES, ASSEMBLY AND VERIFICATION" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#3b7d55;swimlaneFillColor=#eaf5ed;strokeColor=#3b7d55;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="1050" width="1700" height="180" as="geometry"/></mxCell>
        <mxCell id="assets" value="&lt;b&gt;coronapoker-assets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#415c49&quot;&gt;Packages src/main/resources&lt;br&gt;cards, sounds, images, fonts and MODs&lt;br&gt;shared unchanged by both frontends&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9e5e;strokeWidth=2;fontColor=#1f3b28;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="125" y="1100" width="470" height="95" as="geometry"/></mxCell>
        <mxCell id="build" value="&lt;b&gt;Maven 24.11 product reactor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#415c49&quot;&gt;root pom.xml builds modules/pom.xml&lt;br&gt;core + assets + one frontend per executable&lt;br&gt;publishes exactly two product JARs to target/&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9e5e;strokeWidth=2;fontColor=#1f3b28;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="665" y="1100" width="470" height="95" as="geometry"/></mxCell>
        <mxCell id="qa" value="&lt;b&gt;coronapoker-qa and tools/qa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#415c49&quot;&gt;architecture and module contracts, then native GDX&lt;br&gt;mixed Swing/GDX, then multi-process network and recovery&lt;br&gt;release certification; never packaged into the product&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9e5e;strokeWidth=2;fontColor=#1f3b28;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1205" y="1100" width="470" height="95" as="geometry"/></mxCell>

        <mxCell id="eSwingFrontend" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6a4c93;strokeWidth=2.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="swingJar" target="swingAdapter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eGdxFrontend" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6a4c93;strokeWidth=2.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gdxJar" target="gdxAdapter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eSwingContracts" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6a4c93;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="swingAdapter" target="ports"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eGdxContracts" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6a4c93;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="gdxAdapter" target="ports"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="contractCaption" value="Events and state flow to the frontends&lt;br&gt;Decisions and commands flow to the core" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d7a9a8;fontColor=#8f3635;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="955" y="582" width="300" height="42" as="geometry"/></mxCell>
        <mxCell id="eContractsCore" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;strokeColor=#b94a48;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ports" target="engine"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
