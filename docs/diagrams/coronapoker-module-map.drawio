        <mxCell id="eEngineRules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#c0504d;strokeWidth=1.8;exitX=0.4;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="engine" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eEngineNetwork" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;strokeColor=#c0504d;strokeWidth=1.8;exitX=0.62;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="engine" target="network"><mxGeometry relative="1" as="geometry"/></mxCell>
