<mxfile host="app.diagrams.net" type="device">
  <diagram id="coronapoker-modules" name="Module map">
    <mxGraphModel dx="1800" dy="1240" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="CoronaPoker 24.11 GDX architecture" style="text;html=1;fontSize=28;fontStyle=1;fontColor=#17233c;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1350" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="One desktop application, one renderer-neutral game engine, one resource set and one certification model." style="text;html=1;fontSize=15;fontColor=#56627a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="52" y="65" width="1600" height="26" as="geometry"/></mxCell>

        <mxCell id="appsBand" value="PRODUCT DISTRIBUTION" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#263d66;swimlaneFillColor=#eef3fb;strokeColor=#263d66;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="1700" height="205" as="geometry"/></mxCell>
        <mxCell id="gdxJar" value="&lt;b&gt;CoronaPoker-24.11.jar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#44516a&quot;&gt;Main: com.tonikelope.coronapoker.gdx.GdxLauncher&lt;br&gt;libGDX menus, lobby, GPU table and overlays&lt;br&gt;One shaded application containing GDX, core and assets&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#20a7c9;strokeWidth=2;fontColor=#17233c;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="155" width="560" height="120" as="geometry"/></mxCell>

        <mxCell id="presentationBand" value="GDX APPLICATION AND TABLE BOUNDARY" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#6a4c93;swimlaneFillColor=#f4effa;strokeColor=#6a4c93;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="1700" height="225" as="geometry"/></mxCell>
        <mxCell id="gdxAdapter" value="&lt;b&gt;GDX application and presentation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#514660&quot;&gt;GdxApplicationShell, GdxFrontendScreen, GdxTableRenderer and CoronaPokerGdxTable&lt;br&gt;libGDX input, GPU rendering, overlays, audio and platform services&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#20a7c9;strokeWidth=2;fontColor=#17333c;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="180" y="415" width="650" height="115" as="geometry"/></mxCell>
        <mxCell id="ports" value="&lt;b&gt;Renderer-neutral contracts owned by the core&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#514660&quot;&gt;LobbySession, TableSession and TableRenderer&lt;br&gt;typed commands, state snapshots and ordered visual events&lt;br&gt;lifecycle ownership and animation barriers&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffdf4;strokeColor=#d4aa36;strokeWidth=2;fontColor=#3d3219;fontSize=14;align=center;verticalAlign=middle;spacing=7;" vertex="1" parent="1"><mxGeometry x="970" y="405" width="650" height="135" as="geometry"/></mxCell>

        <mxCell id="coreBand" value="SHARED CORE: modules/coronapoker-core/src/main/java" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#b94a48;swimlaneFillColor=#fcedec;strokeColor=#b94a48;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="635" width="1700" height="375" as="geometry"/></mxCell>
        <mxCell id="engine" value="&lt;b&gt;Authoritative game engine and protocol orchestration&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;CoreGameTableFactory and Crupier&lt;br&gt;turns, betting, dealing, showdown and payout&lt;br&gt;Publishes state and events. Accepts renderer-neutral decisions. Imports no frontend types.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffaf9;strokeColor=#c0504d;strokeWidth=2.2;fontColor=#3d2020;fontSize=15;align=center;verticalAlign=middle;spacing=9;" vertex="1" parent="1"><mxGeometry x="500" y="700" width="800" height="115" as="geometry"/></mxCell>
        <mxCell id="lifecycle" value="&lt;b&gt;Lifecycle and table state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;lobby, connect and reconnect&lt;br&gt;pause, stop, exit and recovery&lt;br&gt;seat and session ownership&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="85" y="855" width="375" height="115" as="geometry"/></mxCell>
        <mxCell id="rules" value="&lt;b&gt;Rules, bots and exact money&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;BetRules, PotMath and MoneyCents&lt;br&gt;RIT, rabbit, straddle and ante&lt;br&gt;side pots, hand evaluation and bots&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="485" y="855" width="375" height="115" as="geometry"/></mxCell>
        <mxCell id="network" value="&lt;b&gt;Networking and security&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;NetworkLobbyGateway and wire commands&lt;br&gt;SRA/Ristretto255, DLEQ and signed actions&lt;br&gt;verifiable shuffle and Ed25519 identity&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="855" width="375" height="115" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;b&gt;Persistence and diagnostics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#5f4545&quot;&gt;SQLite history and statistics&lt;br&gt;hand transactions, settlement and recovery&lt;br&gt;DebugLog and statistics synchronization&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0504d;strokeWidth=1.8;fontColor=#3d2020;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1340" y="855" width="375" height="115" as="geometry"/></mxCell>

        <mxCell id="supportBand" value="RESOURCES, ASSEMBLY AND VERIFICATION" style="swimlane;rounded=1;arcSize=4;startSize=34;html=1;fillColor=#3b7d55;swimlaneFillColor=#eaf5ed;strokeColor=#3b7d55;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=15;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="50" y="1050" width="1700" height="180" as="geometry"/></mxCell>
        <mxCell id="assets" value="&lt;b&gt;coronapoker-assets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#415c49&quot;&gt;Packages src/main/resources&lt;br&gt;cards, sounds, images, fonts and MODs&lt;br&gt;consumed by the GDX application&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9e5e;strokeWidth=2;fontColor=#1f3b28;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="125" y="1100" width="470" height="95" as="geometry"/></mxCell>
        <mxCell id="build" value="&lt;b&gt;Maven 24.11 product reactor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#415c49&quot;&gt;root pom.xml builds modules/pom.xml&lt;br&gt;core + assets + GDX application&lt;br&gt;publishes one executable JAR to target/&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9e5e;strokeWidth=2;fontColor=#1f3b28;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="665" y="1100" width="470" height="95" as="geometry"/></mxCell>
        <mxCell id="qa" value="&lt;b&gt;coronapoker-qa and tools/qa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#415c49&quot;&gt;architecture and module contracts&lt;br&gt;GDX scenarios, multi-process network and recovery&lt;br&gt;release certification; never packaged into the product&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5e9e5e;strokeWidth=2;fontColor=#1f3b28;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1205" y="1100" width="470" height="95" as="geometry"/></mxCell>

        <mxCell id="eGdxFrontend" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6a4c93;strokeWidth=2.2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gdxJar" target="gdxAdapter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eGdxCommands" value="commands" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6a4c93;strokeWidth=2;exitX=1;exitY=0.38;entryX=0;entryY=0.38;fontColor=#5a3c83;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gdxAdapter" target="ports"><mxGeometry relative="1" as="geometry"/></mxCell>
