<mxfile host="Electron" modified="2026-10-11T00:00:00.000Z" agent="draw.io" version="29.6.6">
  <diagram id="module-map" name="GDX architecture">
    <mxGraphModel dx="1900" dy="1406" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1406" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="CoronaPoker GDX architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#17233B;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="1050" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Runtime responsibilities, renderer-neutral boundary, Maven modules and verification." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#17233B;fontSize=16;fontColor=#52627A;" vertex="1" parent="1"><mxGeometry x="47" y="65" width="1400" height="28" as="geometry"/></mxCell>
        <mxCell id="releaseLane" value="RELEASE ARTIFACT" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#294A79;swimlaneFillColor=#FFFFFF;strokeColor=#294A79;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1860" height="155" as="geometry"/></mxCell>
        <mxCell id="jar" value="&lt;b&gt;CoronaPoker_&amp;lt;version&amp;gt;.jar&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Main class: com.tonikelope.coronapoker.gdx.GdxLauncher&lt;br&gt;One shaded cross-platform desktop application with core, GDX and resources&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="165" width="900" height="78" as="geometry"/></mxCell>
        <mxCell id="runtimeLane" value="RUNTIME ARCHITECTURE" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#70499B;swimlaneFillColor=#FFFFFF;strokeColor=#70499B;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="1860" height="440" as="geometry"/></mxCell>
        <mxCell id="gdx" value="&lt;b&gt;GDX PRESENTATION&lt;/b&gt;&lt;br&gt;&lt;br&gt;GdxApplicationShell&lt;br&gt;GdxFrontendScreen&lt;br&gt;GdxTableRenderer&lt;br&gt;CoronaPokerGdxTable&lt;br&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Window lifecycle, input, GPU rendering and desktop media&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#E8F7FC;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="405" width="470" height="230" as="geometry"/></mxCell>
        <mxCell id="contract" value="&lt;b&gt;RENDERER-NEUTRAL TABLE CONTRACT&lt;/b&gt;&lt;br&gt;&lt;br&gt;TableSession owns the handoff&lt;br&gt;TableCommandSink receives player commands&lt;br&gt;TableEventBridge attaches one presentation&lt;br&gt;TablePresentation preserves event order&lt;br&gt;TableRenderer exposes presentation barriers&lt;br&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;No libGDX type crosses this boundary&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF9E7;strokeColor=#D79B00;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="715" y="385" width="470" height="270" as="geometry"/></mxCell>
        <mxCell id="core" value="&lt;b&gt;AUTHORITATIVE GAME CORE&lt;/b&gt;&lt;br&gt;&lt;br&gt;NetworkLobbyGateway and LobbySession&lt;br&gt;CoreGameTableFactory and Crupier&lt;br&gt;rules, bots, exact money and side pots&lt;br&gt;transport, cryptography and recovery&lt;br&gt;SQLite persistence, logs and statistics&lt;br&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;The core imports no libGDX classes&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#C94C4C;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1350" y="405" width="470" height="230" as="geometry"/></mxCell>
        <mxCell id="commandToContract" value="TableCommand" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#70499B;strokeWidth=2.4;fontColor=#4E3670;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gdx" target="contract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="commandToCore" value="validated dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#70499B;strokeWidth=2.4;fontColor=#4E3670;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="contract" target="core"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eventsToContract" value="snapshots and events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#C94C4C;strokeWidth=2.4;fontColor=#983733;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.74;entryX=1;entryY=0.74;" edge="1" parent="1" source="core" target="contract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="renderToGdx" value="ordered render calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#25A9D6;strokeWidth=2.4;fontColor=#147A99;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.74;entryX=1;entryY=0.74;" edge="1" parent="1" source="contract" target="gdx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="modulesLane" value="MAVEN MODULES AND VERIFICATION" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#347C53;swimlaneFillColor=#FFFFFF;strokeColor=#347C53;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="785" width="1860" height="611" as="geometry"/></mxCell>
        <mxCell id="coreModule" value="&lt;b&gt;coronapoker-core&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Rules, sessions, networking, bots, security,&lt;br&gt;persistence and the neutral table API&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C94C4C;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="95" y="900" width="430" height="105" as="geometry"/></mxCell>
        <mxCell id="assetsModule" value="&lt;b&gt;coronapoker-assets&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Cards, sounds, images, fonts and bundled resources&lt;br&gt;No Java source&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="95" y="1085" width="430" height="105" as="geometry"/></mxCell>
        <mxCell id="gdxModule" value="&lt;b&gt;coronapoker-gdx&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Depends on core and assets&lt;br&gt;Owns the production launcher and desktop frontend&lt;br&gt;Publishes the executable application JAR&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#25A9D6;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="715" y="985" width="470" height="125" as="geometry"/></mxCell>
        <mxCell id="qaModule" value="&lt;b&gt;coronapoker-qa&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Runs in the normal product reactor&lt;br&gt;Checks boundaries, source ownership and distribution&lt;br&gt;Contains no production runtime code&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1350" y="885" width="430" height="120" as="geometry"/></mxCell>
        <mxCell id="toolsQa" value="&lt;b&gt;tools/qa&lt;/b&gt;&lt;br&gt;&lt;font size=&quot;2&quot;&gt;Opt-in extended test reactor&lt;br&gt;Uses current core and GDX artifacts&lt;br&gt;Provides protocol, recovery, bot and simulation lanes&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#347C53;strokeWidth=2;fontColor=#17233B;fontSize=15;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1350" y="1085" width="430" height="120" as="geometry"/></mxCell>
        <mxCell id="coreDep" value="depends on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#C94C4C;strokeWidth=2.4;fontColor=#983733;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gdxModule" target="coreModule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="assetsDep" value="packages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gdxModule" target="assetsModule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="qaDep" value="checks product reactor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="qaModule" target="gdxModule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="toolsDep" value="tests product artifacts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=13;strokeColor=#347C53;strokeWidth=2.4;fontColor=#285F40;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="toolsQa" target="gdxModule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="moduleNote" value="The root build runs module tests and coronapoker-qa. tools/qa runs only when explicitly requested." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F4FAF6;strokeColor=#7AA98B;strokeWidth=2;fontColor=#285F40;fontSize=15;align=center;verticalAlign=middle;spacing=8;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="580" y="1240" width="740" height="42" as="geometry"/></mxCell>
      </root>
