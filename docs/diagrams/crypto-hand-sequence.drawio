        <mxCell id="s144" value="PHASE 0 · Handshake, identity &amp;amp; genesis anchor  (once per connection, before the hand)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F4ECFC;strokeColor=#7E57A6;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="1660" height="738" as="geometry"/></mxCell>
        <mxCell id="s145" value="PHASE 0b · Verifiable seat draw — commit-reveal randomness beacon  (ONCE at game start, before the first hand)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F4ECFC;strokeColor=#7E57A6;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="896" width="1660" height="1010" as="geometry"/></mxCell>
        <mxCell id="s146" value="PHASE 1 · New-hand barrier + shuffle — commutative SRA lock cascade  (ring order HOST → C1 → C2)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E5F3E3;strokeColor=#5E9E5E;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="1924" width="1660" height="1560" as="geometry"/></mxCell>
        <mxCell id="s147" value="PHASE 2 · Dealing hole cards  (chained DLEQ, verifiable)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#DAF2F3;strokeColor=#0E9C9C;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="3502" width="1660" height="749" as="geometry"/></mxCell>
        <mxCell id="s148" value="PHASE 3a · Preflop betting  (Ed25519-signed actions, ratcheted into H_t)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFEFD6;strokeColor=#D79B00;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="4269" width="1660" height="677" as="geometry"/></mxCell>
        <mxCell id="s149" value="PHASE 4a · Flop — community reveal  (verifiable, signed announce)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E6EFFB;strokeColor=#5B82BE;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="4964" width="1660" height="696" as="geometry"/></mxCell>
        <mxCell id="s150" value="PHASE 3b · Flop betting" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFEFD6;strokeColor=#D79B00;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="5678" width="1660" height="374" as="geometry"/></mxCell>
        <mxCell id="s151" value="PHASE 4b · Turn — community reveal" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E6EFFB;strokeColor=#5B82BE;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="6070" width="1660" height="591" as="geometry"/></mxCell>
        <mxCell id="s152" value="PHASE 3c · Turn betting" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFEFD6;strokeColor=#D79B00;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="6679" width="1660" height="374" as="geometry"/></mxCell>
        <mxCell id="s153" value="PHASE 4c · River — community reveal" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E6EFFB;strokeColor=#5B82BE;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="7071" width="1660" height="591" as="geometry"/></mxCell>
        <mxCell id="s154" value="PHASE 3d · River betting" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFEFD6;strokeColor=#D79B00;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="7680" width="1660" height="374" as="geometry"/></mxCell>
        <mxCell id="s155" value="PHASE 5 · Showdown  (k_pocket reveal, signed)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FBE2E1;strokeColor=#C0504D;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="8072" width="1660" height="674" as="geometry"/></mxCell>
        <mxCell id="s156" value="PHASE 6 · Settlement + receipt consensus  (certifies the hand)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EDE3FA;strokeColor=#7E57A6;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="8764" width="1660" height="696" as="geometry"/></mxCell>
        <mxCell id="s157" value="CROSS-CUTTING · Anti-replay / lockdown / misdeal" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#777777;strokeWidth=1.5;opacity=55;fontColor=#222222;fontStyle=1;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="9478" width="1660" height="192" as="geometry"/></mxCell>
        <mxCell id="s158" style="endArrow=none;html=1;strokeColor=#2E3A48;strokeWidth=2;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="114" as="sourcePoint"/><mxPoint x="300" y="9698" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s159" style="endArrow=none;html=1;strokeColor=#5B82BE;strokeWidth=2;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="114" as="sourcePoint"/><mxPoint x="780" y="9698" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s160" style="endArrow=none;html=1;strokeColor=#5B82BE;strokeWidth=2;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="114" as="sourcePoint"/><mxPoint x="1260" y="9698" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s161" value="&lt;b&gt;HOST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Dealer + Player · server&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E8ECF1;strokeColor=#2E3A48;strokeWidth=2;fontColor=#1f1f1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="56" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="s162" value="&lt;b&gt;HOST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;Dealer + Player · server&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E8ECF1;strokeColor=#2E3A48;strokeWidth=2;fontColor=#1f1f1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="205" y="9698" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="s163" value="&lt;b&gt;CLIENT 1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;human&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E6EFFB;strokeColor=#5B82BE;strokeWidth=2;fontColor=#1f1f1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="685" y="56" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="s164" value="&lt;b&gt;CLIENT 1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;human&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E6EFFB;strokeColor=#5B82BE;strokeWidth=2;fontColor=#1f1f1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="685" y="9698" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="s165" value="&lt;b&gt;CLIENT 2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;human&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E6EFFB;strokeColor=#5B82BE;strokeWidth=2;fontColor=#1f1f1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1165" y="56" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="s166" value="&lt;b&gt;CLIENT 2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;human&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E6EFFB;strokeColor=#5B82BE;strokeWidth=2;fontColor=#1f1f1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1165" y="9698" width="190" height="58" as="geometry"/></mxCell>
        <mxCell id="t1" value="CoronaPoker — Per-hand cryptographic protocol (verifiable SRA)" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1a1a2e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="1400" height="28" as="geometry"/></mxCell>
        <mxCell id="t2" value="One COMPLETE hand — all four streets (preflop · flop · turn · river) through to showdown — with every step shown explicitly. 3-player game: HOST (dealer + player, server) + 2 human clients. Time flows downward. ── solid = send · ┄ dashed = response / async · purple = host push (one explicit arrow per client)." style="text;html=1;fontSize=12;fontStyle=2;fontColor=#5a5a6a;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="32" width="1640" height="20" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;TCP CONNECT + ECDH&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;C1 sends its ephemeral Curve25519 pubkey&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="200" as="sourcePoint"/><mxPoint x="300" y="200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s3" value="&lt;b&gt;ECDH pubkey + encrypted INTRO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;host ephemeral Curve25519 pubkey (raw); then, on the now-encrypted channel, the host INTRO: nick ‖ avatar ‖ session_id ‖ host Ed25519 pubkey ‖ self-sig «JOIN\0»(session_id‖nick‖pubkey)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="256" as="sourcePoint"/><mxPoint x="780" y="256" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s4" value="Both sides run ECDH → deriveChannelSecret: HMAC-SHA512(shared ‖ password) → AES-256 channel key + HMAC-256 key. C1 then captures session_id and pins the host identity FROM THE ENCRYPTED INTRO — verifyJoin(host self-sig) + TOFU (NEW / MATCH / CHANGED). The raw ECDH bytes carry no identity." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="286" width="380" height="106" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;JOIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;C1 pubkey + Ed25519 self-sig «JOIN\0» ‖ session_id ‖ nick ‖ pubkey&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="432" as="sourcePoint"/><mxPoint x="300" y="432" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s6" value="verifyJoin(C1) + TOFU pin (NEW / MATCH / CHANGED)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="462" width="380" height="46" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;TCP CONNECT + ECDH&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;C2 sends its ephemeral Curve25519 pubkey&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="548" as="sourcePoint"/><mxPoint x="300" y="548" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s8" value="&lt;b&gt;ECDH pubkey + encrypted INTRO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;host ephemeral Curve25519 pubkey (raw); then host INTRO: nick ‖ avatar ‖ session_id ‖ host Ed25519 pubkey ‖ self-sig&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="604" as="sourcePoint"/><mxPoint x="1260" y="604" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s9" value="deriveChannelSecret(C2) → C2 AES-256 + HMAC-256 keys. C2 captures session_id + pins the host identity from the encrypted INTRO (verifyJoin + TOFU)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="634" width="380" height="61" as="geometry"/></mxCell>
        <mxCell id="s10" value="&lt;b&gt;JOIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;C2 pubkey + Ed25519 self-sig «JOIN\0» ‖ session_id ‖ nick ‖ pubkey&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="735" as="sourcePoint"/><mxPoint x="300" y="735" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s11" value="verifyJoin(C2) + TOFU pin." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="765" width="380" height="31" as="geometry"/></mxCell>
        <mxCell id="s12" value="GENESIS: HOST, C1 and C2 each derive the 52 Ristretto255 points locally — it NEVER travels. Public anchor decks[0]." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="530" y="810" width="640" height="46" as="geometry"/></mxCell>
        <mxCell id="s13" value="The host USED to shuffle the seats locally and broadcast SEATS, which everyone accepted blindly, so a hostile host could hand-pick the seating and with it the first dealer + blinds (both derived from the permutation head). Replaced by a commit-reveal beacon: every human (clients + HOST) contributes a secret, ALL are committed before ANY is revealed, and the seated order is a fixed function of the combined reveals. No one, host included, can bias it; each peer derives the same order and verifies it. Bots do not contribute." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="530" y="930" width="640" height="121" as="geometry"/></mxCell>
        <mxCell id="s14" value="&lt;b&gt;SEAT_DRAW_BEGIN&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;nonce (32 B) ‖ N ‖ roster · opens the draw (with confirmation)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="1089" as="sourcePoint"/><mxPoint x="780" y="1089" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s15" value="&lt;b&gt;SEAT_DRAW_BEGIN&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;nonce (32 B) ‖ N ‖ roster · opens the draw (with confirmation)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="1143" as="sourcePoint"/><mxPoint x="1260" y="1143" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s16" value="&lt;b&gt;SEAT_COMMIT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;nick ‖ nonce ‖ commit ‖ Ed25519 sig «SEATDRAW» · commit = SHA-256(«SEATCOMMIT\0» ‖ nonce ‖ len(nick) ‖ nick ‖ r): hides r, binds it&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="1199" as="sourcePoint"/><mxPoint x="300" y="1199" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s17" value="&lt;b&gt;SEAT_COMMIT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;nick ‖ nonce ‖ commit ‖ sig   (the HOST commits its own secret too)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="1255" as="sourcePoint"/><mxPoint x="300" y="1255" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s18" value="&lt;b&gt;SEAT_COMMITS&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;bundle of EVERY commit ‖ sig · locked in BEFORE any reveal (one shot per nonce — a re-send for the same nonce is refused)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="1309" as="sourcePoint"/><mxPoint x="780" y="1309" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s19" value="&lt;b&gt;SEAT_COMMITS&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;bundle of EVERY commit ‖ sig · locked in BEFORE any reveal (one shot per nonce — a re-send for the same nonce is refused)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="1363" as="sourcePoint"/><mxPoint x="1260" y="1363" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s20" value="&lt;b&gt;SEAT_REVEAL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;nick ‖ nonce ‖ r (32 B) · safe to open now that all commits are fixed&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="1419" as="sourcePoint"/><mxPoint x="300" y="1419" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s21" value="&lt;b&gt;SEAT_REVEAL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;nick ‖ nonce ‖ r&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="1475" as="sourcePoint"/><mxPoint x="300" y="1475" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s22" value="&lt;b&gt;SEAT_REVEALS&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;bundle of EVERY reveal&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="1529" as="sourcePoint"/><mxPoint x="780" y="1529" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s23" value="&lt;b&gt;SEAT_REVEALS&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;bundle of EVERY reveal&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="1583" as="sourcePoint"/><mxPoint x="1260" y="1583" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s24" value="Each peer INDEPENDENTLY: (1) verifyCommit every reveal against its commit + checks its OWN commit and reveal survived intact in the bundles; (2) seed = SHA-512(«SEATSEED\0» ‖ nonce ‖ per nick ASC: len(nick) ‖ nick ‖ r)[0..48]; (3) seated order = DeterministicShuffle over the CANONICALLY sorted roster with that seed. Same reveals ⇒ byte-identical order everywhere. First dealer + blinds = head of the permutation." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="530" y="1613" width="640" height="91" as="geometry"/></mxCell>
        <mxCell id="s25" value="RECOVER: the host replays the seating over the legacy SEATS# — accepted ONLY when isRECOVER (a fresh game REFUSES it, forcing the commit-reveal). Each client cross-checks it against its OWN persisted seat ring (recoveredSeatingConsistent: the shared players must keep their cyclic order) → warnSeatTampered on a real reorder. Mid-game joiners are appended host-independently by orderNewcomers = sort by H(«SEATJOIN\0» ‖ canonical ring ‖ nick)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="530" y="1718" width="640" height="106" as="geometry"/></mxCell>
        <mxCell id="s26" value="Residual (accepted but DETECTED): the host may abort a round and re-roll; a new nonce over an equal/larger roster raises warnSeatRedraw (popup + registro + Debug)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="530" y="1838" width="640" height="46" as="geometry"/></mxCell>
        <mxCell id="s27" value="&lt;b&gt;HAND_READY&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;C1: new-hand barrier · REPEATS every hand (the seat draw above is once per game)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="1984" as="sourcePoint"/><mxPoint x="300" y="1984" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s28" value="&lt;b&gt;HAND_READY&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;C2: new-hand barrier&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="2040" as="sourcePoint"/><mxPoint x="300" y="2040" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s29" value="&lt;b&gt;START_SRA_CASCADE&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;releases the cascade · HOST mints HAND_ID (random 16 B, delivered in MEGAPACKET)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="2094" as="sourcePoint"/><mxPoint x="780" y="2094" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s30" value="&lt;b&gt;START_SRA_CASCADE&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;releases the cascade · HOST mints HAND_ID (random 16 B, delivered in MEGAPACKET)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="2148" as="sourcePoint"/><mxPoint x="1260" y="2148" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s31" value="HOST applies its own k_pocket over the genesis + Fisher-Yates AES-256-CTR shuffle.
Every member holds two ephemeral scalars: k_pocket and k_community." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="2178" width="380" height="76" as="geometry"/></mxCell>
        <mxCell id="s32" value="&lt;b&gt;DECK_CASCADE_REQ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;deck after HOST&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="2294" as="sourcePoint"/><mxPoint x="780" y="2294" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s33" value="validates 52 points · generates k_pocket / k_community · lock + shuffle
· commitments K_pocket=k·B, K_community=k·B" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="796" y="2324" width="380" height="61" as="geometry"/></mxCell>
        <mxCell id="s34" value="&lt;b&gt;DECK_CASCADE_RESP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;nick ‖ deck′ ‖ K_pocket(C1) ‖ K_community(C1)   — fast, NO proof&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="2425" as="sourcePoint"/><mxPoint x="300" y="2425" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s35" value="&lt;b&gt;DECK_CASCADE_PROOF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;hash(deck′) ‖ Bayer-Groth step proof — ASYNC, sent after the RESP · does NOT block the deal&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="2481" as="sourcePoint"/><mxPoint x="300" y="2481" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s36" value="&lt;b&gt;DECK_CASCADE_REQ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;deck after C1&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="2537" as="sourcePoint"/><mxPoint x="1260" y="2537" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s37" value="validates · generates k_pocket / k_community · lock + shuffle
· K commitments" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="1276" y="2567" width="380" height="61" as="geometry"/></mxCell>
        <mxCell id="s38" value="&lt;b&gt;DECK_CASCADE_RESP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;nick ‖ deck″ ‖ K_pocket(C2) ‖ K_community(C2)   — fast, NO proof&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="2668" as="sourcePoint"/><mxPoint x="300" y="2668" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s39" value="&lt;b&gt;DECK_CASCADE_PROOF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;hash(deck″) ‖ Bayer-Groth step proof — ASYNC · does NOT block the deal&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="2724" as="sourcePoint"/><mxPoint x="300" y="2724" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s40" value="opt. B1 — the step proof is DECOUPLED from the RESP: each peer answers the cascade FAST (deck + commitments) and sends its Bayer-Groth proof separately (DECK_CASCADE_PROOF). The host collects them OFF the deal path (collectAsyncCascadeProofs — matched by hash(deckOut), 45 s window), so the ~0.1–9 s prove never stalls dealing. They feed the DUALLOCK_BUNDLE, assembled + broadcast during betting." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="530" y="2754" width="640" height="91" as="geometry"/></mxCell>
        <mxCell id="s41" value="HOST rotates its own community slots locally: strip k_pocket, re-lock under k_community + RotationProof." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="2859" width="380" height="61" as="geometry"/></mxCell>
        <mxCell id="s42" value="&lt;b&gt;DECK_ROTATION_REQ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;community slots only&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="2960" as="sourcePoint"/><mxPoint x="780" y="2960" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s43" value="strip k_pocket + re-lock under k_community (combined scalar s = u·k_comm)
+ RotationProof (batch-DLEQ of an in-place re-key, no reordering)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="796" y="2990" width="380" height="76" as="geometry"/></mxCell>
        <mxCell id="s44" value="&lt;b&gt;DECK_ROTATION_RESP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;rotated deck ‖ RotationProof(C1)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="3106" as="sourcePoint"/><mxPoint x="300" y="3106" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s45" value="&lt;b&gt;DECK_ROTATION_REQ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;community slots only&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="3162" as="sourcePoint"/><mxPoint x="1260" y="3162" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s46" value="strip k_pocket + re-lock under k_community + RotationProof" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="1276" y="3192" width="380" height="46" as="geometry"/></mxCell>
        <mxCell id="s47" value="&lt;b&gt;DECK_ROTATION_RESP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;rotated deck ‖ RotationProof(C2)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="3278" as="sourcePoint"/><mxPoint x="300" y="3278" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s48" value="&lt;b&gt;MEGAPACKET&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;final deck (pocket intact + rotated community) ‖ HAND_ID ‖ ring order ‖ K commitments&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="3332" as="sourcePoint"/><mxPoint x="780" y="3332" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s49" value="&lt;b&gt;MEGAPACKET&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;final deck (pocket intact + rotated community) ‖ HAND_ID ‖ ring order ‖ K commitments&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="3386" as="sourcePoint"/><mxPoint x="1260" y="3386" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s50" value="H_0 = SHA-256( «HAND\0» ‖ HAND_ID ‖ N ‖ Σ sorted[id‖K_pocket‖K_community] ‖ SHA-256(deck) )  — seeds the state chain" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="530" y="3416" width="640" height="46" as="geometry"/></mxCell>
        <mxCell id="s51" value="HOST extends one DealChain per slot (anchor = MEGAPACKET point) and strips its own lock locally, each with a per-card DLEQ proof." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="3536" width="380" height="61" as="geometry"/></mxCell>
        <mxCell id="s52" value="&lt;b&gt;REQ_SRA_UNLOCK_CHAIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;phase = POCKET · strip C1 k_pocket from the OTHER slots&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="3637" as="sourcePoint"/><mxPoint x="780" y="3637" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s53" value="verifies each chain anchors to its MEGAPACKET · applies k_pocket⁻¹
+ attaches a DLEQ proof (Chaum-Pedersen, dom. «SRA_DLEQ\0»).
Guard: REFUSES its own slot (anti self-strip) → otherwise LOCKDOWN." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="796" y="3667" width="380" height="106" as="geometry"/></mxCell>
        <mxCell id="s54" value="&lt;b&gt;RESP_SRA_UNLOCK_CHAIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;extended chain + DLEQ&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="3813" as="sourcePoint"/><mxPoint x="300" y="3813" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s55" value="&lt;b&gt;REQ_SRA_UNLOCK_CHAIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;phase = POCKET · strip C2 k_pocket from the OTHER slots&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="3869" as="sourcePoint"/><mxPoint x="1260" y="3869" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s56" value="anchor check · applies k_pocket⁻¹ + DLEQ · refuses its own slot" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="1276" y="3899" width="380" height="46" as="geometry"/></mxCell>
        <mxCell id="s57" value="&lt;b&gt;RESP_SRA_UNLOCK_CHAIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;extended chain + DLEQ&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="3985" as="sourcePoint"/><mxPoint x="300" y="3985" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s58" value="verifies chains vs each K_pocket · takes the tail = «single-locked» residual per player." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="4015" width="380" height="46" as="geometry"/></mxCell>
        <mxCell id="s59" value="&lt;b&gt;POCKET_CARDS&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;single-locked residual per player · each recipient removes its own k_pocket and resolves against genesis&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="4099" as="sourcePoint"/><mxPoint x="780" y="4099" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s60" value="&lt;b&gt;POCKET_CARDS&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;single-locked residual per player · each recipient removes its own k_pocket and resolves against genesis&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="4153" as="sourcePoint"/><mxPoint x="1260" y="4153" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s61" value="guardarFosilSRA: persists the state for crash recovery." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="4183" width="380" height="46" as="geometry"/></mxCell>
        <mxCell id="s62" value="&lt;b&gt;DUALLOCK_BUNDLE&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;full genesis→MEGAPACKET proof (Bayer-Groth + batch-DLEQ) — assembled from the async step proofs, broadcast DURING betting, off the deal path&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="4327" as="sourcePoint"/><mxPoint x="780" y="4327" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s63" value="&lt;b&gt;DUALLOCK_BUNDLE&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;full genesis→MEGAPACKET proof (Bayer-Groth + batch-DLEQ) — assembled from the async step proofs, broadcast DURING betting, off the deal path&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="4381" as="sourcePoint"/><mxPoint x="1260" y="4381" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s64" value="Once the host has collected the async DECK_CASCADE_PROOF from every peer it assembles the honest-shuffle bundle and broadcasts it here. C1 and C2 enqueue it in ShuffleVerificationQueue and verify it in the BACKGROUND against their own recomputed genesis + pocket/community boundary — zero impact on play. A missing/failed proof only sets receipt flags (bit1 deck-pending / bit1+bit2 no-proof), never blocks the hand." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="530" y="4411" width="640" height="91" as="geometry"/></mxCell>
        <mxCell id="s65" value="&lt;b&gt;ACTION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;( FOLD · CHECK · CALL · BET · RAISE · ALL-IN ) · C1 acts, signs «ACTION\0»&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="4542" as="sourcePoint"/><mxPoint x="300" y="4542" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s66" value="&lt;b&gt;ACTION (relay)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;host forwards C1 signed action to C2&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="4598" as="sourcePoint"/><mxPoint x="1260" y="4598" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s67" value="&lt;b&gt;ACTION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;( FOLD · CHECK · CALL · BET · RAISE · ALL-IN ) · C2 acts, signs «ACTION\0»&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="4654" as="sourcePoint"/><mxPoint x="300" y="4654" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s68" value="&lt;b&gt;ACTION (relay)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;host forwards C2 signed action to C1&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="4710" as="sourcePoint"/><mxPoint x="780" y="4710" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s69" value="&lt;b&gt;ACTION&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;( FOLD · CHECK · CALL · BET · RAISE · ALL-IN ) · HOST acts, signs «ACTION\0»&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="4764" as="sourcePoint"/><mxPoint x="780" y="4764" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s70" value="&lt;b&gt;ACTION&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;( FOLD · CHECK · CALL · BET · RAISE · ALL-IN ) · HOST acts, signs «ACTION\0»&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="4818" as="sourcePoint"/><mxPoint x="1260" y="4818" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s71" value="Each ACTION is a 92 B canonical record (cents, NFC); the actor signs it «ACTION\0», every peer verifies the sig and binds type/amount/player/hand to the played action (bad sig or mismatch ⇒ synthetic FOLD + flag), then absorbs H_{t+1} = SHA-256( record ‖ sig ). Acting order follows the button &amp;amp; blinds." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="530" y="4848" width="640" height="76" as="geometry"/></mxCell>
        <mxCell id="s72" value="HOST strips its own k_community on the flop slots locally (DLEQ)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="4998" width="380" height="46" as="geometry"/></mxCell>
        <mxCell id="s73" value="&lt;b&gt;REQ_SRA_UNLOCK_CHAIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;phase = COMMUNITY (flop offset)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="5084" as="sourcePoint"/><mxPoint x="780" y="5084" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s74" value="strips its k_community over the copies of the others · DLEQ
+ GATE-6: refuses if the strip would reveal a genesis card too early." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="796" y="5114" width="380" height="76" as="geometry"/></mxCell>
        <mxCell id="s75" value="&lt;b&gt;RESP_SRA_UNLOCK_CHAIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;chain + DLEQ&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="5230" as="sourcePoint"/><mxPoint x="300" y="5230" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s76" value="&lt;b&gt;REQ_SRA_UNLOCK_CHAIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;phase = COMMUNITY (flop offset)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="5286" as="sourcePoint"/><mxPoint x="1260" y="5286" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s77" value="&lt;b&gt;RESP_SRA_UNLOCK_CHAIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;chain + DLEQ + GATE-6&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="5342" as="sourcePoint"/><mxPoint x="300" y="5342" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s78" value="&lt;b&gt;FLOP_PIECE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;C1 piece (only its k_community remains)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="5398" as="sourcePoint"/><mxPoint x="780" y="5398" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s79" value="&lt;b&gt;FLOP_PIECE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;C2 piece (only its k_community remains)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="5454" as="sourcePoint"/><mxPoint x="1260" y="5454" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s80" value="&lt;b&gt;COMM_REVEAL&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;signed ACTION_COMMUNITY record (3 cards packed in AMOUNT_CENTS)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="5508" as="sourcePoint"/><mxPoint x="780" y="5508" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s81" value="&lt;b&gt;COMM_REVEAL&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;signed ACTION_COMMUNITY record (3 cards packed in AMOUNT_CENTS)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="5562" as="sourcePoint"/><mxPoint x="1260" y="5562" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s82" value="Each peer cross-checks the announce against its own piece indices (anti board-fork) and absorbs it into H_t." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="530" y="5592" width="640" height="46" as="geometry"/></mxCell>
        <mxCell id="s83" value="&lt;b&gt;ACTION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;( FOLD · CHECK · CALL · BET · RAISE · ALL-IN ) · C1 acts, signs «ACTION\0»&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="5738" as="sourcePoint"/><mxPoint x="300" y="5738" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s84" value="&lt;b&gt;ACTION (relay)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;host forwards C1 signed action to C2&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="5794" as="sourcePoint"/><mxPoint x="1260" y="5794" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s85" value="&lt;b&gt;ACTION&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;( FOLD · CHECK · CALL · BET · RAISE · ALL-IN ) · C2 acts, signs «ACTION\0»&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="5850" as="sourcePoint"/><mxPoint x="300" y="5850" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s86" value="&lt;b&gt;ACTION (relay)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;host forwards C2 signed action to C1&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="5906" as="sourcePoint"/><mxPoint x="780" y="5906" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s87" value="&lt;b&gt;ACTION&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;( FOLD · CHECK · CALL · BET · RAISE · ALL-IN ) · HOST acts, signs «ACTION\0»&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="5960" as="sourcePoint"/><mxPoint x="780" y="5960" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s88" value="&lt;b&gt;ACTION&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;( FOLD · CHECK · CALL · BET · RAISE · ALL-IN ) · HOST acts, signs «ACTION\0»&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="6014" as="sourcePoint"/><mxPoint x="1260" y="6014" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s89" value="HOST strips its own k_community on the turn slot locally (DLEQ)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="6104" width="380" height="46" as="geometry"/></mxCell>
