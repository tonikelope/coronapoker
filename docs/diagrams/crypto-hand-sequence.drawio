        <mxCell id="s92" value="&lt;b&gt;REQ_SRA_UNLOCK_CHAIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;phase = COMMUNITY (turn offset)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="6302" as="sourcePoint"/><mxPoint x="1260" y="6302" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s93" value="&lt;b&gt;RESP_SRA_UNLOCK_CHAIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;chain + DLEQ + GATE-6&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=8 5;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1260" y="6358" as="sourcePoint"/><mxPoint x="300" y="6358" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s94" value="&lt;b&gt;TURN_PIECE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;C1 piece&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="6414" as="sourcePoint"/><mxPoint x="780" y="6414" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s95" value="&lt;b&gt;TURN_PIECE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;C2 piece&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#34343a;strokeWidth=1.8;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="6470" as="sourcePoint"/><mxPoint x="1260" y="6470" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s96" value="&lt;b&gt;COMM_REVEAL&lt;/b&gt;  &lt;span style=&quot;font-size:9px;color:#7E57A6&quot;&gt;▶ to C1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#333&quot;&gt;signed ACTION_COMMUNITY record (1 card)&lt;/span&gt;" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7E57A6;strokeWidth=2.4;fontSize=10;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;spacingBottom=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="6524" as="sourcePoint"/><mxPoint x="780" y="6524" as="targetPoint"/></mxGeometry></mxCell>
