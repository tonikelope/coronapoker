        <mxCell id="s105" value="HOST strips its own k_community on the river slot locally (DLEQ)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D9C45A;strokeWidth=1.2;fontColor=#3a3320;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;size=12;" vertex="1" parent="1"><mxGeometry x="316" y="7105" width="380" height="46" as="geometry"/></mxCell>
