  <diagram id="testing-certification" name="Testing and certification">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="CORONAPOKER TESTING AND CERTIFICATION" style="text;html=1;align=center;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="220" y="25" width="1160" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Four validation layers. qa.cmd composes the gates required by the change." style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="buildLane" value="1  PRODUCT BUILD" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#163A5C;strokeWidth=2;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="145" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="buildCommand" value="&lt;b&gt;qa.cmd test&lt;/b&gt;&#xa;&#xa;Clean product build and normal tests" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#5B82BE;strokeWidth=2;fontColor=#1F2937;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="145" width="335" height="125" as="geometry"/></mxCell>
        <mxCell id="buildScope" value="&lt;b&gt;Product tests&lt;/b&gt;&#xa;&#xa;Rules, networking, persistence, security, GDX contracts and architecture" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#5B82BE;strokeWidth=2;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="735" y="145" width="405" height="125" as="geometry"/></mxCell>
        <mxCell id="buildResult" value="&lt;b&gt;Verified build&lt;/b&gt;&#xa;&#xa;Runnable JAR in target" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F4E4;strokeColor=#5E9E5E;strokeWidth=2;fontColor=#1F2937;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="145" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="qaLane" value="2  EXTENDED QA" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#6B4C9A;strokeColor=#513873;strokeWidth=2;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="325" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="qaCommand" value="&lt;b&gt;qa.cmd extended&lt;/b&gt;&#xa;&#xa;Product gate plus opt-in qa-all" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2ECF8;strokeColor=#7E57A6;strokeWidth=2;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="325" width="335" height="125" as="geometry"/></mxCell>
        <mxCell id="qaScope" value="&lt;b&gt;Large regression suites&lt;/b&gt;&#xa;&#xa;Fast and slow replayable non-bot QA&#xa;Optional statistical bot lane" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBF9FD;strokeColor=#7E57A6;strokeWidth=2;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="735" y="325" width="405" height="125" as="geometry"/></mxCell>
        <mxCell id="qaResult" value="&lt;b&gt;Targeted evidence&lt;/b&gt;&#xa;&#xa;Not part of every product build" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F4E4;strokeColor=#5E9E5E;strokeWidth=2;fontColor=#1F2937;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="325" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="headlessLane" value="3  HEADLESS CAMPAIGNS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#A66A00;strokeColor=#7D5000;strokeWidth=2;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="505" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="headlessCommand" value="&lt;b&gt;headless-sim.cmd&lt;/b&gt;&#xa;&#xa;Seeded and replayable" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4DD;strokeColor=#D79B00;strokeWidth=2;fontColor=#1F2937;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="505" width="335" height="125" as="geometry"/></mxCell>
        <mxCell id="headlessScope" value="&lt;b&gt;High-volume simulation&lt;/b&gt;&#xa;&#xa;Protocol, faults, settlement, recovery, SQLite and production bots" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFBF2;strokeColor=#D79B00;strokeWidth=2;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="735" y="505" width="405" height="125" as="geometry"/></mxCell>
        <mxCell id="headlessResult" value="&lt;b&gt;Stress evidence&lt;/b&gt;&#xa;&#xa;No complete GDX table lifecycle" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F4E4;strokeColor=#5E9E5E;strokeWidth=2;fontColor=#1F2937;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="505" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="certLane" value="4  GDX CERTIFICATION" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8B3A3A;strokeColor=#672B2B;strokeWidth=2;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="55" y="685" width="245" height="205" as="geometry"/></mxCell>
        <mxCell id="certCommand" value="&lt;b&gt;qa.cmd scenarios &amp;lt;mode&amp;gt;&lt;/b&gt;&#xa;&#xa;quick, fast, balanced or stress&#xa;&#xa;Delegates to certify.cmd&#xa;Optional scenario and seed replay" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FBEAEA;strokeColor=#C0504D;strokeWidth=2;fontColor=#1F2937;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="685" width="335" height="205" as="geometry"/></mxCell>
        <mxCell id="certCatalogue" value="&lt;b&gt;GdxScenarioContract&lt;/b&gt;&#xa;&#xa;One executable catalogue&#xa;Historical and new scenarios&#xa;Language-neutral label oracles&#xa;&#xa;Real sockets and separate processes where required" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C0504D;strokeWidth=2;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="735" y="685" width="405" height="205" as="geometry"/></mxCell>
        <mxCell id="certResult" value="&lt;b&gt;Behaviour certificate&lt;/b&gt;&#xa;&#xa;Fresh Maven process per mapped test&#xa;Fail-fast execution&#xa;Base and derived seeds&#xa;CSV, JSON and per-test logs" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E7F4E4;strokeColor=#5E9E5E;strokeWidth=2;fontColor=#1F2937;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="685" width="350" height="205" as="geometry"/></mxCell>
        <mxCell id="manual" value="Manual review complements automation for visual quality, exact pixels, audio devices, real Internet and operating-system display behaviour." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;strokeWidth=1.5;fontColor=#374151;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="210" y="945" width="1180" height="55" as="geometry"/></mxCell>
