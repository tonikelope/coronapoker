<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tonikelope</groupId>
        <artifactId>coronapoker-migration-reactor</artifactId>
        <version>24.11-SNAPSHOT</version>
    </parent>
    <artifactId>coronapoker-core</artifactId>
    <name>CoronaPoker core</name>

    <dependencies>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>com/tonikelope/coronapoker/core/**/*.java</include>
                        <include>com/tonikelope/coronapoker/table/**/*.java</include>
                        <include>com/tonikelope/coronapoker/bot/context/**/*.java</include>
                        <include>com/tonikelope/coronapoker/bot/eval/**/*.java</include>
                        <include>com/tonikelope/coronapoker/crypto/**/*.java</include>
                        <include>org/alberta/**/*.java</include>
                        <include>com/tonikelope/coronapoker/BetRules.java</include>
                        <include>com/tonikelope/coronapoker/BettingRoundState.java</include>
                        <include>com/tonikelope/coronapoker/BuyinCount.java</include>
                        <include>com/tonikelope/coronapoker/BuyinRules.java</include>
                        <include>com/tonikelope/coronapoker/CanonicalActionRecord.java</include>
                        <include>com/tonikelope/coronapoker/CriticalVoteEnvelope.java</include>
                        <include>com/tonikelope/coronapoker/DeterministicShuffle.java</include>
                        <include>com/tonikelope/coronapoker/EndOfHandRebuyWire.java</include>
                        <include>com/tonikelope/coronapoker/GameCommandMailbox.java</include>
                        <include>com/tonikelope/coronapoker/HandBalanceRoster.java</include>
                        <include>com/tonikelope/coronapoker/HandCloseTransaction.java</include>
                        <include>com/tonikelope/coronapoker/HandCreateTransaction.java</include>
                        <include>com/tonikelope/coronapoker/HandPotCents.java</include>
                        <include>com/tonikelope/coronapoker/HandStateChain.java</include>
                        <include>com/tonikelope/coronapoker/HandverifyReceiptEnvelope.java</include>
                        <include>com/tonikelope/coronapoker/InitialBuyinWire.java</include>
                        <include>com/tonikelope/coronapoker/MoneyCents.java</include>
                        <include>com/tonikelope/coronapoker/PositionWireV1.java</include>
                        <include>com/tonikelope/coronapoker/PotMath.java</include>
                        <include>com/tonikelope/coronapoker/PotCardsEnvelope.java</include>
                        <include>com/tonikelope/coronapoker/RabbitFeeLedger.java</include>
                        <include>com/tonikelope/coronapoker/RecoveredActionBatch.java</include>
                        <include>com/tonikelope/coronapoker/RecoveredActionCodec.java</include>
                        <include>com/tonikelope/coronapoker/RecoveredActionSqlReader.java</include>
                        <include>com/tonikelope/coronapoker/RecoveryActionReceiveState.java</include>
                        <include>com/tonikelope/coronapoker/RecoveryBalanceReconciler.java</include>
                        <include>com/tonikelope/coronapoker/RecoveryReceiveState.java</include>
                        <include>com/tonikelope/coronapoker/RecoverySnapshotV1.java</include>
                        <include>com/tonikelope/coronapoker/RecoveryGameKeyDataReader.java</include>
                        <include>com/tonikelope/coronapoker/RemoteRebuyBarrier.java</include>
                        <include>com/tonikelope/coronapoker/SeatDraw.java</include>
                        <include>com/tonikelope/coronapoker/SeatRing.java</include>
                        <include>com/tonikelope/coronapoker/SettlementPresentation.java</include>
                        <include>com/tonikelope/coronapoker/SettlementRecord.java</include>
                        <include>com/tonikelope/coronapoker/ShuffleVerificationQueue.java</include>
                        <include>com/tonikelope/coronapoker/TableFailure.java</include>
                        <include>com/tonikelope/coronapoker/TableTerminationWire.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>reuse-neutral-classic-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../../src/main/java</source>
                                <source>${project.basedir}/../../src/main/java/com/tonikelope/coronapoker/core</source>
                                <source>${project.basedir}/../../src/main/java/com/tonikelope/coronapoker/table</source>
                                <source>${project.basedir}/../../src/main/java/com/tonikelope/coronapoker/bot/context</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
