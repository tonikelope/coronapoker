<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tonikelope</groupId>
        <artifactId>coronapoker-modules</artifactId>
        <version>27.54</version>
    </parent>
    <artifactId>coronapoker-assets</artifactId>
    <name>CoronaPoker shared assets</name>

    <build>
        <resources>
            <resource>
                <directory>${project.basedir}/../../src/main/resources</directory>
                <excludes>
                    <exclude>images/emoji_chat/*.png</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>${project.build.directory}/generated-resources/emoji</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../..</directory>
                <includes>
                    <include>robert_rules.pdf</include>
                    <include>robert_rules_es.pdf</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>pack-chat-emoji-atlas</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>-Djava.awt.headless=true</argument>
                                <argument>${project.basedir}/../../tools/build/PackChatEmoji.java</argument>
                                <argument>${project.basedir}/../../src/main/resources/images/emoji_chat</argument>
                                <argument>${project.build.directory}/generated-resources/emoji/images/emoji_atlas</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
