<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tonikelope</groupId>
        <artifactId>coronapoker-modules</artifactId>
        <version>27.56</version>
    </parent>
    <artifactId>coronapoker-gdx</artifactId>
    <name>CoronaPoker GDX application</name>

    <properties>
        <coronapoker.gdx.excludedGroups>certification</coronapoker.gdx.excludedGroups>
        <jcefmaven.version>152.0.6</jcefmaven.version>
        <jcef.natives.version>jcef-17e805a+cef-152.0.6+g708dc14+chromium-152.0.7977.83</jcef.natives.version>
        <!-- Profiles replace these non-matching placeholders with the native
        filenames that must be removed from the platform-specific fat JAR. -->
        <gdx.native.exclude.1>META-INF/coronapoker-keep-native-1</gdx.native.exclude.1>
        <gdx.native.exclude.2>META-INF/coronapoker-keep-native-2</gdx.native.exclude.2>
        <gdx.native.exclude.3>META-INF/coronapoker-keep-native-3</gdx.native.exclude.3>
        <gdx.native.exclude.4>META-INF/coronapoker-keep-native-4</gdx.native.exclude.4>
        <gdx.native.exclude.5>META-INF/coronapoker-keep-native-5</gdx.native.exclude.5>
        <gdx.native.exclude.6>META-INF/coronapoker-keep-native-6</gdx.native.exclude.6>
        <gdx.native.exclude.7>META-INF/coronapoker-keep-native-7</gdx.native.exclude.7>
        <gdx.native.exclude.8>META-INF/coronapoker-keep-native-8</gdx.native.exclude.8>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.tonikelope</groupId>
            <artifactId>coronapoker-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tonikelope</groupId>
            <artifactId>coronapoker-assets</artifactId>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx</artifactId>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
        </dependency>
        <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <version>${jcefmaven.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-lwjgl3</artifactId>
            <version>${libgdx.version}</version>
            <exclusions>
                <exclusion><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId></exclusion>
                <exclusion><groupId>org.lwjgl</groupId><artifactId>lwjgl-glfw</artifactId></exclusion>
                <exclusion><groupId>org.lwjgl</groupId><artifactId>lwjgl-jemalloc</artifactId></exclusion>
                <exclusion><groupId>org.lwjgl</groupId><artifactId>lwjgl-openal</artifactId></exclusion>
                <exclusion><groupId>org.lwjgl</groupId><artifactId>lwjgl-opengl</artifactId></exclusion>
                <exclusion><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency><groupId>com.badlogicgames.gdx</groupId><artifactId>gdx-platform</artifactId><version>${libgdx.version}</version><classifier>natives-desktop</classifier></dependency>
        <dependency><groupId>com.badlogicgames.gdx</groupId><artifactId>gdx-freetype</artifactId><version>${libgdx.version}</version></dependency>
        <dependency><groupId>com.badlogicgames.gdx</groupId><artifactId>gdx-freetype-platform</artifactId><version>${libgdx.version}</version><classifier>natives-desktop</classifier></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl</artifactId><version>${lwjgl.version}</version></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-glfw</artifactId><version>${lwjgl.version}</version></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-jemalloc</artifactId><version>${lwjgl.version}</version></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-openal</artifactId><version>${lwjgl.version}</version></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-opengl</artifactId><version>${lwjgl.version}</version></dependency>
        <dependency><groupId>org.lwjgl</groupId><artifactId>lwjgl-stb</artifactId><version>${lwjgl.version}</version></dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>--add-modules</arg>
                        <arg>jdk.httpserver</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${coronapoker.gdx.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <outputFile>${project.build.directory}/CoronaPoker_${coronapoker.version}.staged.jar</outputFile>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.tonikelope.coronapoker.gdx.GdxLauncher</mainClass>
                                    <manifestEntries>
                                        <SplashScreen-Image>images/splash.gif</SplashScreen-Image>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                        <Add-Exports>java.base/java.lang java.desktop/sun.awt java.desktop/sun.java2d</Add-Exports>
                                        <Add-Opens>java.desktop/sun.awt java.desktop/sun.lwawt java.desktop/sun.lwawt.macosx</Add-Opens>
                                        <CoronaPoker-Visual-Reference>627c71e4f</CoronaPoker-Visual-Reference>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.badlogicgames.gdx:gdx-platform</artifact>
                                    <excludes>
                                        <exclude>${gdx.native.exclude.1}</exclude>
                                        <exclude>${gdx.native.exclude.2}</exclude>
                                        <exclude>${gdx.native.exclude.3}</exclude>
                                        <exclude>${gdx.native.exclude.4}</exclude>
                                        <exclude>${gdx.native.exclude.5}</exclude>
                                        <exclude>${gdx.native.exclude.6}</exclude>
                                        <exclude>${gdx.native.exclude.7}</exclude>
                                        <exclude>${gdx.native.exclude.8}</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>com.badlogicgames.gdx:gdx-freetype-platform</artifact>
                                    <excludes>
                                        <exclude>${gdx.native.exclude.1}</exclude>
                                        <exclude>${gdx.native.exclude.2}</exclude>
                                        <exclude>${gdx.native.exclude.3}</exclude>
                                        <exclude>${gdx.native.exclude.4}</exclude>
                                        <exclude>${gdx.native.exclude.5}</exclude>
                                        <exclude>${gdx.native.exclude.6}</exclude>
                                        <exclude>${gdx.native.exclude.7}</exclude>
                                        <exclude>${gdx.native.exclude.8}</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>publish-complete-gdx-jar</id>
                        <phase>package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>${maven.multiModuleProjectDirectory}/tools/build/AtomicJarPublisher.java</argument>
                                <argument>${project.build.directory}/CoronaPoker_${coronapoker.version}.staged.jar</argument>
                                <argument>${distribution.directory}/CoronaPoker_${coronapoker.version}.jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jcef-windows-amd64</id>
            <activation>
                <os><family>Windows</family><arch>amd64</arch></os>
            </activation>
            <properties>
