<?xml version="1.0" encoding="UTF-8"?>
<!--
  Opt-in Maven module for the extended QA suite. Deterministic game-code tests
  are the default; bot-quality simulations are explicitly opt-in. It is not
  part of the product reactor and is never packaged in the executable JAR.

  The self-contained entry point builds the current product sources first:

      mvn -f tools/reactor/pom.xml verify

  See ../../docs/TESTING.md for every lane, its cost and when to use it. See
  ./src/test/java/com/tonikelope/coronapoker/bot/harness/README.md for the
  statistical bot-quality methodology and result interpretation.

  Run directly after installing the current product artifacts:

      mvn '-DskipTests' install

  Standalone invocations remain available after installing the exact product
  checkout into the local Maven repository:

      mvn -f tools/qa/pom.xml test             # fast code/regression tests (no bot quality)
      mvn -f tools/qa/pom.xml test -P qa-bots  # explicit bot-quality lane only
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tonikelope</groupId>
        <artifactId>coronapoker-modules</artifactId>
        <version>25.25</version>
        <relativePath>../../modules/pom.xml</relativePath>
    </parent>
    <groupId>com.tonikelope.qa</groupId>
    <artifactId>coronapoker-extended-qa</artifactId>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <qa.user.home>${project.build.directory}/qa-home</qa.user.home>
        <!-- Test lane selection (JUnit 5 tags). Defaults give the FAST lane:
        run everything EXCEPT tests tagged @Tag("slow"). The `qa-heavy`
        and `qa-all` profiles select the non-bot slow lanes; the
        statistical bot lane is only selected by the explicit `qa-bots`
        profile. See docs/TESTING.md. -->
        <qa.groups></qa.groups>
        <qa.excludedGroups>slow</qa.excludedGroups>
    </properties>

    <build>
        <!-- Tests live under src/test/java relative to this pom. -->
        <testSourceDirectory>src/test/java</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Each test class runs in its own JVM fork so the
                    Bot.TRACKER_MEMORY static map cannot race
                    between concurrent matchups. 0.6C uses roughly
                    five concurrent forks on an 8-core machine. -->
                    <forkCount>0.6C</forkCount>
                    <reuseForks>false</reuseForks>
                    <!-- Deterministic and stateless. Surefire's "balanced" order
                    persists one .surefire-<hash> timing file per filter set in
                    tools/qa/, which polluted long-lived checkouts. -->
                    <runOrder>alphabetical</runOrder>
                    <failIfNoTests>true</failIfNoTests>
                    <!-- JUnit 5 tag lanes. Empty qa.groups = no positive
                    filter; qa.excludedGroups=slow (the default) skips the
                    heavy tests. Overridable by the qa-heavy/qa-all
                    profiles or directly, e.g. -Dqa.excludedGroups= to run everything. -->
                    <groups>${qa.groups}</groups>
                    <excludedGroups>${qa.excludedGroups}</excludedGroups>
                    <!-- Surefire's default patterns do not include *Smoke.
                    Declare the standard patterns again because an explicit
                    includes block replaces rather than extends the defaults. -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*Smoke.java</include>
                    </includes>
                    <!-- Forward the iteration-volume knobs into each fork. When
                    not supplied on the command line these arrive as the
                    literal "${qa.sessions}", which QaConfig parses as
                    "absent" and falls back to the per-test default. Lower
                    the volume for fast local iteration, e.g.
                    mvn test '-Dqa.sessions=40' '-Dqa.hands=25' -->
                    <systemPropertyVariables>
                        <!-- Concurrent forks must never share persistent identities.
                        The fork suffix prevents Ed25519 key creation/ACL races and
                        keeps all QA state inside the ignored build directory. -->
                        <user.home>${qa.user.home}/fork-${surefire.forkNumber}</user.home>
                        <qa.sessions>${qa.sessions}</qa.sessions>
                        <qa.hands>${qa.hands}</qa.hands>
                        <qa.sim.hands>${qa.sim.hands}</qa.sim.hands>
                        <qa.sim.seed>${qa.sim.seed}</qa.sim.seed>
                        <qa.sim.hand>${qa.sim.hand}</qa.sim.hand>
                        <qa.sim.trace>${qa.sim.trace}</qa.sim.trace>
                        <qa.sim.faults>${qa.sim.faults}</qa.sim.faults>
                        <qa.sim.fault.case>${qa.sim.fault.case}</qa.sim.fault.case>
                        <qa.sim.bot.hands>${qa.sim.bot.hands}</qa.sim.bot.hands>
                        <qa.sim.bot.hand>${qa.sim.bot.hand}</qa.sim.bot.hand>
                        <qa.sim.lifecycle.case>${qa.sim.lifecycle.case}</qa.sim.lifecycle.case>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- The extended suite exercises the renderer-neutral core and the
        production GDX application from the same reactor. -->
        <dependency>
            <groupId>com.tonikelope</groupId>
            <artifactId>coronapoker-core</artifactId>
            <version>${coronapoker.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tonikelope</groupId>
            <artifactId>coronapoker-gdx</artifactId>
            <version>${coronapoker.version}</version>
        </dependency>
        <!-- JUnit 5 is used only by the QA suite, not by the game. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Test lanes, selected by JUnit 5 @Tag. The DEFAULT build is the
        fast lane (see the qa.* properties above): everything except
        tests tagged "slow". These profiles flip that selection.

        Slow tests are the costly regression guards: the bot-AI statistical matchups
        (bot/harness + smoke/GameFlowSmoke + bot/eval Monte-Carlo) and
        the crypto perf/differential/cascade suite and the protocol campaigns.
        See docs/TESTING.md for the current execution policy. -->

        <!-- Explicit name for the normal deterministic lane. The same
        selection is already the default when no profile is supplied;
        this profile makes automated and NetBeans invocations self-documenting. -->
        <profile>
            <id>qa-fast</id>
            <properties>
                <qa.groups></qa.groups>
                <qa.excludedGroups>slow</qa.excludedGroups>
            </properties>
        </profile>

        <!-- Non-bot slow tests only. Statistical bot quality remains a separate
        explicit lane so this aggregate cannot saturate a developer host. -->
        <profile>
            <id>qa-heavy</id>
            <properties>
                <qa.groups>slow</qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/bot/harness/*Test.java</exclude>
                                <exclude>**/bot/eval/MemoizedHandPotentialTest.java</exclude>
                                <exclude>**/smoke/GameFlowSmoke.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Bot-quality lane only. It deliberately selects the statistical
        matchups, Monte-Carlo hand-potential test and the headless game-flow
        smoke; it does not provide feedback for ordinary game-code changes. -->
        <profile>
            <id>qa-bots</id>
            <properties>
                <qa.groups>slow</qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>slow</groups>
                            <excludedGroups></excludedGroups>
                            <!-- Keep bot quality narrowly scoped. The old
                            **/bot/**/*.java pattern also scanned fast
                            evaluator tests and helper classes, making the
                            lane look larger than its statistical scope. -->
                            <includes combine.self="override">
                                <include>**/bot/harness/*Test.java</include>
                                <include>**/bot/eval/MemoizedHandPotentialTest.java</include>
                                <include>**/smoke/GameFlowSmoke.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Heavy cryptographic/differential lane only. -->
        <profile>
            <id>qa-crypto</id>
            <properties>
                <qa.groups>slow</qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>slow</groups>
                            <excludedGroups></excludedGroups>
                            <includes combine.self="override">
                                <include>**/crypto/*Test.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Slow real-socket integration lane, kept apart from bot quality and
        from deterministic game-code tests. -->
        <profile>
            <id>qa-network</id>
            <properties>
                <qa.groups>slow</qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>slow</groups>
                            <excludedGroups></excludedGroups>
                            <includes combine.self="override">
                                <include>**/net/SocketStallIntegrationTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Deterministic headless protocol campaign. Unlike qa-bots, this lane
        composes the production consensus primitives and gives every simulated
        peer an independent HandStateChain. Volume and replay seed are
        controlled with -Dqa.sim.hands and -Dqa.sim.seed. -->
        <profile>
            <id>qa-protocol-sim</id>
            <properties>
                <qa.groups>protocol-sim</qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>protocol-sim</groups>
                            <excludedGroups></excludedGroups>
                            <includes combine.self="override">
                                <include>**/protocolsim/*Test.java</include>
                                <!-- This tagged regression intentionally lives
                                beside the recovery unit tests, outside the
                                protocolsim package. -->
                                <include>**/RecoveredActionBatchTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Single umbrella lane for every automated non-visual game check.
        Running with java.awt.headless=true makes accidental JFrame/display
        dependencies fail instead of silently turning this into a GUI smoke.
        The owner-only ACL shape smoke is environment-specific and remains in
        its dedicated lane; all identity/signature behavior still runs here. -->
        <profile>
            <id>qa-headless-all</id>
            <properties>
                <qa.groups></qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups></groups>
                            <excludedGroups></excludedGroups>
                            <systemPropertyVariables combine.children="append">
                                <java.awt.headless>true</java.awt.headless>
                            </systemPropertyVariables>
                            <includes combine.self="override">
                                <include>**/Test*.java</include>
                                <include>**/*Test.java</include>
                                <include>**/*Tests.java</include>
                                <include>**/*TestCase.java</include>
                                <include>**/*Smoke.java</include>
                            </includes>
                            <excludes combine.self="override">
                                <exclude>**/IdentityKeypairAclSmoke.java</exclude>
                                <!-- These assert statistical playing strength, not
                                game integrity. qa-protocol-sim supplies a scalable
                                per-hand invariant campaign using the same real bots. -->
                                <exclude>**/bot/harness/*Test.java</exclude>
                                <exclude>**/bot/eval/MemoizedHandPotentialTest.java</exclude>
                                <exclude>**/smoke/GameFlowSmoke.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Whole replayable suite plus non-bot slow lanes. Statistical bot
        quality is deliberately excluded and requires -P qa-bots. -->
        <profile>
            <id>qa-all</id>
            <properties>
                <qa.groups></qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/bot/harness/*Test.java</exclude>
                                <exclude>**/bot/eval/MemoizedHandPotentialTest.java</exclude>
                                <exclude>**/smoke/GameFlowSmoke.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
