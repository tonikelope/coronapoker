<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standalone Maven module for the off-line QA suite. Deterministic game-code
  tests are the default; bot-quality simulations are explicitly opt-in.

  This module is intentionally NOT a sub-module of the main CoronaPoker
  pom.xml — building or packaging the game (`mvn package` in the repo
  root) does not compile, run, or include any of these tests. The QA
  suite is developer/maintainer tooling and lives outside the shipped
  artifact.

  To run the suite:

      cd tools/qa
      mvn -o test                    # deterministic fast lane; bot quality is opt-in

  See ./src/test/java/com/tonikelope/coronapoker/bot/harness/README.md
  for the full description of what these tests measure and how to
  interpret the results.

  First-time setup:

      cd ../..                       # repo root
      mvn install -DskipTests        # publishes CoronaPoker to ~/.m2 with the version set in the root pom

  Then any time you want to run the bot QA suite:

      cd tools/qa
      mvn -o test                    # fast code/regression tests (no bot quality)
      mvn -o test -P qa-bots         # explicit bot-quality lane only
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.tonikelope.qa</groupId>
    <artifactId>coronapoker-bot-tests</artifactId>
        <version>23.59</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Override with -Dcoronapoker.version=X.Y if you have a different
        local install. Bump this property in sync with the root pom version
        so `mvn -o test` resolves against the just-installed jar. -->
        <coronapoker.version>23.59</coronapoker.version>

        <!-- Test lane selection (JUnit 5 tags). Defaults give the FAST lane:
        run everything EXCEPT tests tagged @Tag("slow"). The `qa-heavy`
        and `qa-release` profiles select the non-bot slow lanes; the
        statistical bot lane is only selected by the explicit `qa-bots`
        profile. See the Testing section in README.md. -->
        <qa.groups></qa.groups>
        <qa.excludedGroups>slow</qa.excludedGroups>
    </properties>

    <build>
        <!-- Tests live under src/test/java relative to this pom. -->
        <testSourceDirectory>src/test/java</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Each test class runs in its own JVM fork so the
                    Bot.TRACKER_MEMORY static map cannot race
                    between concurrent matchups. 0.6C uses roughly
                    five concurrent forks on an 8-core machine. -->
                    <forkCount>0.6C</forkCount>
                    <reuseForks>false</reuseForks>
                    <runOrder>balanced</runOrder>
                    <failIfNoTests>true</failIfNoTests>
                    <!-- JUnit 5 tag lanes. Empty qa.groups = no positive
                    filter; qa.excludedGroups=slow (the default) skips the
                    heavy tests. Overridable by the qa-heavy/qa-release
                    profiles or directly, e.g. -Dqa.excludedGroups= to run everything. -->
                    <groups>${qa.groups}</groups>
                    <excludedGroups>${qa.excludedGroups}</excludedGroups>
                    <!-- Los ficheros *Smoke NO los recoge el patron por defecto, que solo
                    mira *Test/*Tests/*TestCase, asi que un `mvn test` a secas se
                    saltaba los diecisiete que hay: no corrian NUNCA salvo que se
                    invocaran a mano con -Dtest. Se anaden aqui junto a los patrones
                    de siempre, que hay que repetir porque declarar includes los
                    sustituye en vez de sumarse. -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*Smoke.java</include>
                    </includes>
                    <!-- Forward the iteration-volume knobs into each fork. When
                    not supplied on the command line these arrive as the
                    literal "${qa.sessions}", which QaConfig parses as
                    "absent" and falls back to the per-test default. Lower
                    the volume for fast local iteration, e.g.
                    mvn -o test -Dqa.sessions=40 -Dqa.hands=25 -->
                    <systemPropertyVariables>
                        <qa.sessions>${qa.sessions}</qa.sessions>
                        <qa.hands>${qa.hands}</qa.hands>
                        <qa.sim.hands>${qa.sim.hands}</qa.sim.hands>
                        <qa.sim.seed>${qa.sim.seed}</qa.sim.seed>
                        <qa.sim.hand>${qa.sim.hand}</qa.sim.hand>
                        <qa.sim.trace>${qa.sim.trace}</qa.sim.trace>
                        <qa.sim.faults>${qa.sim.faults}</qa.sim.faults>
                        <qa.sim.fault.case>${qa.sim.fault.case}</qa.sim.fault.case>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!-- Main CoronaPoker game artifact. Run `mvn install -DskipTests`
        from the repo root once so this resolves from ~/.m2. -->
        <dependency>
            <groupId>com.tonikelope</groupId>
            <artifactId>CoronaPoker</artifactId>
            <version>${coronapoker.version}</version>
        </dependency>
        <!-- All the runtime libraries the main game depends on, mirrored
        here so the test JVM can run Bot.java and its collaborators
        end-to-end (the system-scope dependency above does not
        transitively pull these). -->
        <dependency>
            <groupId>com.googlecode.soundlibs</groupId>
            <artifactId>tritonus-share</artifactId>
            <version>0.3.7.4</version>
        </dependency>
        <dependency>
            <groupId>com.googlecode.soundlibs</groupId>
            <artifactId>mp3spi</artifactId>
            <version>1.9.5.4</version>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.14</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.51.1.0</version>
        </dependency>
        <!-- JUnit 5 — only used by the QA suite, not by the game. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Test lanes, selected by JUnit 5 @Tag. The DEFAULT build is the
        fast lane (see the qa.* properties above): everything except
        tests tagged "slow". These profiles flip that selection.

        Slow tests are the heavy regression guards over already-stable,
        out-of-scope subsystems: the bot-AI statistical matchups
        (bot/harness + smoke/GameFlowSmoke + bot/eval Monte-Carlo) and
        the crypto perf/differential/cascade suite. Measured full suite
        ~4.6 min; fast lane well under a minute. See the Testing section in README.md. -->

        <!-- Explicit name for the normal deterministic lane. The same
        selection is already the default when no profile is supplied;
        this profile makes CI/NetBeans invocations self-documenting. -->
        <profile>
            <id>qa-fast</id>
            <properties>
                <qa.groups></qa.groups>
                <qa.excludedGroups>slow</qa.excludedGroups>
            </properties>
        </profile>

        <!-- Non-bot slow tests only. Statistical bot quality remains a separate
        explicit lane so this aggregate cannot saturate a developer host. -->
        <profile>
            <id>qa-heavy</id>
            <properties>
                <qa.groups>slow</qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/bot/harness/*Test.java</exclude>
                                <exclude>**/bot/eval/MemoizedHandPotentialTest.java</exclude>
                                <exclude>**/smoke/GameFlowSmoke.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Bot-quality lane only. It deliberately selects the statistical
        matchups, Monte-Carlo hand-potential test and the headless game-flow
        smoke; it does not provide feedback for ordinary game-code changes. -->
        <profile>
            <id>qa-bots</id>
            <properties>
                <qa.groups>slow</qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>slow</groups>
                            <excludedGroups></excludedGroups>
                            <!-- Keep bot quality narrowly scoped. The old
                            **/bot/**/*.java pattern also scanned fast
                            evaluator tests and helper classes, making the
                            lane look larger than its statistical scope. -->
                            <includes combine.self="override">
                                <include>**/bot/harness/*Test.java</include>
                                <include>**/bot/eval/MemoizedHandPotentialTest.java</include>
                                <include>**/smoke/GameFlowSmoke.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Heavy cryptographic/differential lane only. -->
        <profile>
            <id>qa-crypto</id>
            <properties>
                <qa.groups>slow</qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>slow</groups>
                            <excludedGroups></excludedGroups>
                            <includes combine.self="override">
                                <include>**/crypto/*Test.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Slow real-socket integration lane, kept apart from bot quality and
        from deterministic game-code tests. -->
        <profile>
            <id>qa-network</id>
            <properties>
                <qa.groups>slow</qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>slow</groups>
                            <excludedGroups></excludedGroups>
                            <includes combine.self="override">
                                <include>**/net/SocketStallIntegrationTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Deterministic headless protocol campaign. Unlike qa-bots, this lane
        composes the production consensus primitives and gives every simulated
        peer an independent HandStateChain. Volume and replay seed are
        controlled with -Dqa.sim.hands and -Dqa.sim.seed. -->
        <profile>
            <id>qa-protocol-sim</id>
            <properties>
                <qa.groups>protocol-sim</qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>protocol-sim</groups>
                            <excludedGroups></excludedGroups>
                            <includes combine.self="override">
                                <include>**/protocolsim/*Test.java</include>
                                <include>**/ProtocolExitRecoverySimulationTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Whole deterministic suite plus non-bot slow lanes. Statistical bot
        quality is deliberately excluded and requires -P qa-bots. -->
        <profile>
            <id>qa-release</id>
            <properties>
                <qa.groups></qa.groups>
                <qa.excludedGroups></qa.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/bot/harness/*Test.java</exclude>
                                <exclude>**/bot/eval/MemoizedHandPotentialTest.java</exclude>
                                <exclude>**/smoke/GameFlowSmoke.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
