<?xml version="1.0" encoding="UTF-8"?>
<!--
  OPT-IN QA reactor. The default root build compiles and tests the product
  modules. This reactor adds tools/qa to the same Maven session, so the extended
  QA suite compiles against the current core and GDX artifacts without a
  local install or a separately maintained version pin.

      # product gate plus fast extended QA (all tests tagged slow are excluded)
      # the fast lane is the DEFAULT; no profile is needed
      mvn -f tools/reactor/pom.xml verify

      # full deterministic suite plus crypto and socket-stall checks;
      # statistical bot/harness quality is excluded from this aggregate
      mvn -f tools/reactor/pom.xml verify -P qa-all

      # non-bot slow lanes aggregate (bot quality remains explicit)
      mvn -f tools/reactor/pom.xml verify -P qa-heavy

      # a single test class
      mvn -f tools/reactor/pom.xml verify '-Dtest=BetRulesTest' '-Dsurefire.failIfNoSpecifiedTests=false'

  The fast lane is the DEFAULT (no profile). The `qa-heavy` and `qa-all`
  profiles are declared in tools/qa/pom.xml and select the non-bot slow tests
  inside this reactor; `qa-bots` is the separate statistical lane. See
  ../../docs/TESTING.md for the complete lane and execution policy.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.tonikelope</groupId>
    <artifactId>coronapoker-qa-reactor</artifactId>
    <version>25.74</version>
    <packaging>pom</packaging>
    <name>CoronaPoker QA reactor (opt-in aggregator)</name>

    <modules>
        <!-- Product modules. Reactor order follows their dependency graph. -->
        <module>../../modules</module>
        <!-- Opt-in JUnit 5 QA suite, resolved against this same reactor. -->
        <module>../qa</module>
    </modules>
</project>
