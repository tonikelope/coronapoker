<?xml version="1.0" encoding="UTF-8"?>
<!--
  OPT-IN QA reactor. The default root build compiles and tests the product
  modules. This reactor adds tools/qa to the same Maven session, so the classic
  QA suite compiles against the current core and Swing artifacts without a
  local install or a separately maintained version pin.

      # fast feedback for a refactor — game + all tests EXCEPT the slow bot sims
      # (the fast lane is the DEFAULT; no profile needed)
      mvn -f tools/reactor/pom.xml -o verify

      # full deterministic suite plus crypto and socket-stall checks;
      # statistical bot/harness quality is excluded from this aggregate
      mvn -f tools/reactor/pom.xml -o verify -P qa-release

      # non-bot slow lanes aggregate (bot quality remains explicit)
      mvn -f tools/reactor/pom.xml -o verify -P qa-heavy

      # a single test class
      mvn -f tools/reactor/pom.xml -o verify '-Dtest=BetRulesTest' '-Dsurefire.failIfNoSpecifiedTests=false'

  The fast lane is the DEFAULT (no profile). The `qa-heavy` and `qa-release`
  profiles are declared in tools/qa/pom.xml and select the non-bot slow tests
  inside this reactor; `qa-bots` is the separate statistical lane. See that pom
  for what each lane covers.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.tonikelope</groupId>
    <artifactId>coronapoker-qa-reactor</artifactId>
    <version>24.11-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CoronaPoker QA reactor (opt-in aggregator)</name>

    <modules>
        <!-- Product modules. Reactor order follows their dependency graph. -->
        <module>../../modules</module>
        <!-- Opt-in JUnit 5 QA suite, resolved against this same reactor. -->
        <module>../qa</module>
    </modules>
</project>
